<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="Font.Primary">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="Font.Body">Segoe UI Variable Text</FontFamily>

    <sys:Double x:Key="FontSize.Display" xmlns:sys="clr-namespace:System;assembly=mscorlib">24</sys:Double>
    <sys:Double x:Key="FontSize.Title" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="FontSize.Body" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="FontSize.Small" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
</ResourceDictionary>

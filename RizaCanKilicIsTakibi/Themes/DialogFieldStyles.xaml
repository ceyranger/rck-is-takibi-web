<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="Brush.EntryDialogBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE8F0FA" Offset="0"/>
        <GradientStop Color="#FFF4F7FB" Offset="0.45"/>
        <GradientStop Color="#FFEAF3EC" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.EntryDialogHeader" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0F5CC0" Offset="0"/>
        <GradientStop Color="#FF1A7AD9" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="EntryDialogCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Margin" Value="14"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#1A0A1C30" BlurRadius="24" ShadowDepth="0" Opacity="0.9"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EntryDialogHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.EntryDialogHeader}"/>
        <Setter Property="CornerRadius" Value="16,16,0,0"/>
        <Setter Property="Padding" Value="20,14,20,12"/>
    </Style>

    <Style x:Key="EntryDialogEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#CCFFFFFF"/>
    </Style>

    <Style x:Key="EntryDialogTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="EntryDialogFooterStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}"/>
        <Setter Property="CornerRadius" Value="0,0,16,16"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>

    <Style x:Key="EntryFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Backward-compatible aliases used by Ana Bilgi event dialog -->
    <Style x:Key="EventFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource EntryFieldLabelStyle}"/>

    <Style x:Key="EntryFieldBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style x:Key="EventFieldBoxStyle" TargetType="Border" BasedOn="{StaticResource EntryFieldBoxStyle}">
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="EntryFieldTextBoxStyle" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="EntryFieldMultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource EntryFieldTextBoxStyle}">
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="MinHeight" Value="80"/>
    </Style>

    <Style x:Key="EntryFieldDatePickerStyle" TargetType="DatePicker">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="EntryProjectSummaryStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFF1F6FC"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="EntryLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
</ResourceDictionary>

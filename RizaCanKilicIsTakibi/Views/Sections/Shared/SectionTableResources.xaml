<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModels="clr-namespace:RizaCanKilicIsTakibi.ViewModels">
    <Style x:Key="TadilatRowBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="#FFD5E0EE"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TadilatCellBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="#FFD5E0EE"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Background" Value="White"/>
    </Style>

    <DataTemplate x:Key="ColumnFilterHeaderTemplate" DataType="{x:Type viewModels:ColumnFilterViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,6,0"
                       Text="{Binding Header}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Stretch"/>

            <ToggleButton x:Name="HeaderFilterButton"
                          Grid.Column="1"
                          Width="20"
                          Height="20"
                          Focusable="False"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          Padding="0">
                <TextBlock Text="▼"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFilteredOrSorted}" Value="True">
                                    <Setter Property="Foreground" Value="#FFFFF2A8"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </ToggleButton>

            <Popup Placement="Bottom"
                   PlacementTarget="{Binding ElementName=HeaderFilterButton}"
                   IsOpen="{Binding IsChecked, ElementName=HeaderFilterButton, Mode=TwoWay}"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Width="280"
                        Padding="10"
                        Background="White"
                        BorderBrush="#FFD0DBEA"
                        BorderThickness="1"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">
                    <StackPanel>
                        <TextBlock Text="{Binding Header}"
                                   FontWeight="SemiBold"
                                   Foreground="#FF0E1A2A"
                                   Margin="0,0,0,8"/>

                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="A-Z"
                                    Command="{Binding SortAscendingCommand}"
                                    Margin="0,0,6,6"
                                    Padding="10,4"
                                    MinWidth="56"/>
                            <Button Content="Z-A"
                                    Command="{Binding SortDescendingCommand}"
                                    Margin="0,0,6,6"
                                    Padding="10,4"
                                    MinWidth="56"/>
                            <Button Content="Sıfırla"
                                    Command="{Binding ClearSortCommand}"
                                    Margin="0,0,0,6"
                                    Padding="10,4"
                                    MinWidth="68"/>
                        </WrapPanel>

                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"/>

                        <CheckBox Content="Boşları dahil et"
                                  IsChecked="{Binding IncludeBlanks}"
                                  Margin="0,0,0,8"/>

                        <DockPanel Margin="0,0,0,8">
                            <Button Content="Tümünü seç"
                                    Command="{Binding SelectAllCommand}"
                                    DockPanel.Dock="Left"
                                    Margin="0,0,6,0"
                                    Padding="10,4"/>
                            <Button Content="Temizle"
                                    Command="{Binding ClearSelectionCommand}"
                                    DockPanel.Dock="Left"
                                    Padding="10,4"/>
                        </DockPanel>

                        <Border BorderBrush="#FFE2E8F2"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4">
                            <ScrollViewer MaxHeight="220"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding OptionsView}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Value}"
                                                      IsChecked="{Binding IsSelected}"
                                                      Margin="2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </DataTemplate>
</ResourceDictionary>

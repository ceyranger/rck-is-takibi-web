<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="TadilatRowBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="#FFD5E0EE"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TadilatCellBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="#FFD5E0EE"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Background" Value="White"/>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:RizaCanKilicIsTakibi.Models">

    <!-- Kompakt liste satırı: satırı şişirmez -->
    <DataTemplate x:Key="SearchResultListItemTemplate" DataType="{x:Type models:SearchResultItem}">
        <Border x:Name="RowBorder"
                Padding="10,8"
                Margin="0,0,0,4"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="8"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="#FFE8EEF7"
                        BorderBrush="#FFCAD7EA"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,3"
                        VerticalAlignment="Top"
                        Margin="0,0,10,0">
                    <TextBlock Text="{Binding KindLabel}"
                               Foreground="#FF24415E"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="1" MinWidth="0">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding SubtitleLine}"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="12"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="#FFF0F5FB"/>
                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#FFB8C9DE"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Sağ panel detay içeriği -->
    <DataTemplate x:Key="SearchResultDetailTemplate" DataType="{x:Type models:SearchResultItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="4">
                <Border Background="#FFE8EEF7"
                        BorderBrush="#FFCAD7EA"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,4"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,14">
                    <TextBlock Text="{Binding KindLabel}"
                               Foreground="#FF24415E"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </Border>

                <TextBlock Text="{Binding Title}"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>

                <TextBlock Text="{Binding SubtitleLine}"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           FontSize="14"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Margin="0,16,0,0"
                        Padding="12,10"
                        Background="#FFF7F9FC"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Eşleşme"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                        <TextBlock Text="{Binding MatchReasonDisplay}"
                                   Margin="0,6,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Primary}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding MatchSnippet}"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="12,10"
                        Background="White"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Özet"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                        <TextBlock Text="{Binding Summary}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding BoardLabel}"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Button Content="Bu kayda git"
                        Margin="0,18,0,0"
                        MinWidth="140"
                        HorizontalAlignment="Left"
                        Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Geriye uyum: eski ad artık kompakt satırı kullanır -->
    <DataTemplate x:Key="SearchResultCardTemplate" DataType="{x:Type models:SearchResultItem}">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SearchResultListItemTemplate}"/>
    </DataTemplate>
</ResourceDictionary>

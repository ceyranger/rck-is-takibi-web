<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="YibfSelectableSurfaceStyle" TargetType="Border">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="#FFD8E1EE"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="#FFEAF1FD"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="YibfPassiveSurfaceStyle" TargetType="Border" BasedOn="{StaticResource YibfSelectableSurfaceStyle}">
        <Setter Property="Padding" Value="12"/>
    </Style>
</ResourceDictionary>

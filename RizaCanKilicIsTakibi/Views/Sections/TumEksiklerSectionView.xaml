<UserControl x:Class="RizaCanKilicIsTakibi.Views.Sections.TumEksiklerSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:RizaCanKilicIsTakibi.Behaviors"
             xmlns:viewModels="clr-namespace:RizaCanKilicIsTakibi.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1180">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RizaCanKilicIsTakibi;component/Views/Sections/Shared/YibfSurfaceResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="TÜM EKSİKLER"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Ada parsel ve yapı sahibi bazlı eksik özeti."
                               Foreground="{StaticResource Brush.TextSecondary}"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <WrapPanel Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           DockPanel.Dock="Right">
                    <Button Content="Yenile"
                            Command="{Binding RefreshTumEksiklerCommand}"
                            Style="{StaticResource GhostButton}"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="4">
                    <Border Style="{StaticResource MissingProjectToolbarChipStyle}">
                        <TextBlock Text="{Binding TumEksikler.TotalGroupCount, StringFormat={}İş: {0}}"
                                   FontWeight="SemiBold"
                                   Foreground="#FF20344C"/>
                    </Border>
                    <Border Style="{StaticResource MissingProjectToolbarChipStyle}">
                        <TextBlock Text="{Binding TumEksikler.TotalItemCount, StringFormat={}Eksik: {0}}"
                                   FontWeight="SemiBold"
                                   Foreground="#FF20344C"/>
                    </Border>
                    <Border Style="{StaticResource MissingProjectToolbarChipStyle}">
                        <TextBlock Text="{Binding TumEksikler.CriticalItemCount, StringFormat={}Kritik: {0}}"
                                   FontWeight="SemiBold"
                                   Foreground="#FF9F1D1D"/>
                    </Border>
                    <Border Style="{StaticResource MissingProjectToolbarChipStyle}">
                        <TextBlock Text="{Binding TumEksikler.UnmatchedItemCount, StringFormat={}Eşleşmeyen: {0}}"
                                   FontWeight="SemiBold"
                                   Foreground="#FF8A5B00"/>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Height="38"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding TumEksikler.SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Grid.Column="1"
                              Height="38"
                              Margin="0,0,8,0"
                              ItemsSource="{Binding TumEksikler.SourceFilters}"
                              SelectedItem="{Binding TumEksikler.SelectedSourceFilter}"/>
                    <ComboBox Grid.Column="2"
                              Height="38"
                              Margin="0,0,8,0"
                              ItemsSource="{Binding TumEksikler.SeverityFilters}"
                              SelectedItem="{Binding TumEksikler.SelectedSeverityFilter}"/>
                    <ComboBox Grid.Column="3"
                              Height="38"
                              Margin="0,0,8,0"
                              ToolTip="Personel filtresi"
                              ItemsSource="{Binding TumEksikler.PersonnelFilters}"
                              SelectedItem="{Binding TumEksikler.SelectedPersonnelFilter}"/>
                    <CheckBox Grid.Column="4"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              Content="Eşleşmeyenler"
                              IsChecked="{Binding TumEksikler.ShowUnmatched}"/>
                    <CheckBox Grid.Column="5"
                              VerticalAlignment="Center"
                              Content="Boş zorunlu"
                              IsChecked="{Binding TumEksikler.ShowBlankRequired}"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,8,0,0"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <TextBlock Text="Gösterilecek eksik bulunamadı."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextSecondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TumEksikler.HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox ItemsSource="{Binding TumEksikler.Groups}"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         Style="{StaticResource VirtualizedListBoxStyle}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource VirtualizedListBoxItemStyle}">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="IsTabStop" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:EksikIsGroupViewModel}">
                            <Border Style="{StaticResource YibfPassiveSurfaceStyle}"
                                    Margin="0,0,0,10"
                                    Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="{Binding HeaderText}"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DetailText}"
                                                       Margin="0,3,0,0"
                                                       Foreground="{StaticResource Brush.TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <WrapPanel DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right">
                                            <Border Style="{StaticResource MissingProjectToolbarChipStyle}">
                                                <TextBlock Text="{Binding EksikCount, StringFormat={}Eksik: {0}}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FF20344C"/>
                                            </Border>
                                            <Border Style="{StaticResource MissingProjectToolbarChipStyle}">
                                                <TextBlock Text="{Binding CriticalCount, StringFormat={}Kritik: {0}}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FF9F1D1D"/>
                                            </Border>
                                        </WrapPanel>
                                    </DockPanel>

                                    <Separator Grid.Row="1" Margin="0,10,0,10"/>

                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewModels:EksikItemViewModel}">
                                                <Border Margin="0,0,0,8"
                                                        Padding="10"
                                                        CornerRadius="8"
                                                        BorderBrush="#FFE0E7EF"
                                                        BorderThickness="1"
                                                        Background="White"
                                                        behaviors:DoubleClickCommandBehavior.Command="{Binding DataContext.SelectEksikItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        behaviors:DoubleClickCommandBehavior.CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="150"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Background="{Binding SeverityBrush}"
                                                                CornerRadius="8"
                                                                Padding="8,6"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding SeverityLabel}"
                                                                       Foreground="{Binding SeverityForegroundBrush}"
                                                                       FontWeight="SemiBold"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                            <TextBlock Text="{Binding FieldLabel}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Reason}"
                                                                       Margin="0,4,0,0"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{StaticResource Brush.TextSecondary}"/>
                                                            <TextBlock Text="{Binding SourceContext}"
                                                                       Margin="0,4,0,0"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{StaticResource Brush.TextSecondary}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasSourceContext}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding NoteText}"
                                                                       Margin="0,4,0,0"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{StaticResource Brush.TextSecondary}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2"
                                                                    HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding SourceModule}"
                                                                       FontWeight="SemiBold"
                                                                       TextAlignment="Right"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding UpdatedAtText}"
                                                                       Margin="0,4,0,0"
                                                                       Foreground="{StaticResource Brush.TextSecondary}"
                                                                       TextAlignment="Right"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>

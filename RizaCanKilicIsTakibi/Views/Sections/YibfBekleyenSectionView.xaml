<UserControl x:Class="RizaCanKilicIsTakibi.Views.Sections.YibfBekleyenSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:RizaCanKilicIsTakibi.Models"
             xmlns:viewModels="clr-namespace:RizaCanKilicIsTakibi.ViewModels"
             xmlns:behaviors="clr-namespace:RizaCanKilicIsTakibi.Behaviors"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RizaCanKilicIsTakibi;component/Views/Sections/Shared/YibfSurfaceResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="ACİL İŞ ÖZET" FontFamily="{StaticResource Font.Primary}" FontSize="24" FontWeight="SemiBold"/>
                                            <TextBlock Text="Kırmızı ve sarı işaretli işlerin kategori bazlı özeti." Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                            <Button Content="Excel Dışa" Command="{Binding ExportExcelCommand}"/>
                                        </WrapPanel>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel>
                                                <TextBlock Text="Acil İş Özeti" FontFamily="{StaticResource Font.Primary}" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                                <Border Style="{StaticResource MissingProjectToolbarChipStyle}" DockPanel.Dock="Right">
                                                    <TextBlock Text="{Binding AcilIsOzetVisibleCount, StringFormat=Kayıt: {0}}" FontWeight="SemiBold" Foreground="#FF20344C"/>
                                                </Border>
                                                <Border Style="{StaticResource MissingProjectToolbarChipStyle}"
                                                        DockPanel.Dock="Right"
                                                        Padding="0"
                                                        MinWidth="220">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding AcilIsOzetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                 MinHeight="34"
                                                                 Margin="8,0,0,0"
                                                                 VerticalContentAlignment="Center"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"/>
                                                        <TextBlock Grid.Column="0"
                                                                   IsHitTestVisible="False"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#FF8A9BB0"
                                                                   Text="Kartlarda ara...">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AcilIsOzetSearchText}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Button Grid.Column="1"
                                                                Content="×"
                                                                Command="{Binding ClearAcilIsOzetSearchCommand}"
                                                                MinWidth="28"
                                                                MinHeight="28"
                                                                Margin="2"
                                                                Padding="0"
                                                                Style="{StaticResource GhostButton}"/>
                                                    </Grid>
                                                </Border>
                                            </DockPanel>
                                            <ListBox Grid.Row="1"
                                                     ItemsSource="{Binding AcilIsOzetItemsView}"
                                                     Margin="0,12,0,0"
                                                     Focusable="False"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     ScrollViewer.IsDeferredScrollingEnabled="False"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     Style="{StaticResource VirtualizedListBoxStyle}">
                                                <ListBox.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.ContainerStyle>
                                                            <Style TargetType="{x:Type GroupItem}">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                            <Expander IsExpanded="False" Margin="0,0,0,10">
                                                                                <Expander.Header>
                                                                                    <Border Style="{StaticResource YibfPassiveSurfaceStyle}" Padding="12,10">
                                                                                        <DockPanel>
                                                                                            <TextBlock Text="{Binding Name}"
                                                                                                       FontFamily="{StaticResource Font.Primary}"
                                                                                                       FontSize="16"
                                                                                                       FontWeight="SemiBold"
                                                                                                       DockPanel.Dock="Left"/>
                                                                                            <Border Style="{StaticResource MissingProjectToolbarChipStyle}" DockPanel.Dock="Right">
                                                                                                <TextBlock Text="{Binding ItemCount, StringFormat=Kayıt: {0}}"
                                                                                                           FontWeight="SemiBold"
                                                                                                           Foreground="#FF20344C"/>
                                                                                            </Border>
                                                                                        </DockPanel>
                                                                                    </Border>
                                                                                </Expander.Header>
                                                                                <ItemsPresenter Margin="0,10,0,0"/>
                                                                            </Expander>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </GroupStyle.ContainerStyle>
                                                    </GroupStyle>
                                                </ListBox.GroupStyle>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource VirtualizedListBoxItemStyle}">
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Setter Property="IsTabStop" Value="False"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type viewModels:AcilIsOzetItemViewModel}">
                                                        <Border Style="{StaticResource YibfPassiveSurfaceStyle}"
                                                                Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="92"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        Background="{Binding PriorityBrush}"
                                                                        CornerRadius="8"
                                                                        Padding="8,6"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top">
                                                                    <TextBlock Text="{Binding PriorityLabel}"
                                                                               Foreground="{Binding PriorityForegroundBrush}"
                                                                               FontWeight="SemiBold"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="1"
                                                                           Margin="12,0,0,0"
                                                                           Text="{Binding Summary}"
                                                                           VerticalAlignment="Top"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"
                                                                           TextAlignment="Left"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel>
                                                <TextBlock Text="Proje Onay Takibi" FontFamily="{StaticResource Font.Primary}" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                                <Border Style="{StaticResource MissingProjectToolbarChipStyle}" DockPanel.Dock="Right">
                                                    <TextBlock Text="{Binding YibfModule.FilteredBekleyenGruplarCount, StringFormat=Proje: {0}}" FontWeight="SemiBold" Foreground="#FF20344C"/>
                                                </Border>
                                                <Border Style="{StaticResource MissingProjectToolbarChipStyle}"
                                                        DockPanel.Dock="Right"
                                                        Padding="0"
                                                        MinWidth="220">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding YibfModule.PendingSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                 MinHeight="34"
                                                                 Margin="8,0,0,0"
                                                                 VerticalContentAlignment="Center"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"/>
                                                        <TextBlock Grid.Column="0"
                                                                   IsHitTestVisible="False"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#FF8A9BB0"
                                                                   Text="Projelerde ara...">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding YibfModule.PendingSearchText}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Button Grid.Column="1"
                                                                Content="×"
                                                                Command="{Binding YibfModule.ClearPendingSearchCommand}"
                                                                MinWidth="28"
                                                                MinHeight="28"
                                                                Margin="2"
                                                                Padding="0"
                                                                Style="{StaticResource GhostButton}"/>
                                                    </Grid>
                                                </Border>
                                            </DockPanel>
                                            <WrapPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal">
                                                <Button Margin="0,0,6,6"
                                                        Padding="10,6"
                                                        Command="{Binding YibfModule.SelectPendingApprovalFilterCommand}"
                                                        CommandParameter="{x:Static models:YibfAnaBilgiApprovalStatuses.FilterAll}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding YibfModule.IsPendingFilterAllSelected}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Background" Value="#FFE8EEF5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock>
                                                        <Run Text="Tümü ("/>
                                                        <Run Text="{Binding YibfModule.PendingFilterAllCount, Mode=OneWay}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                </Button>
                                                <Button Margin="0,0,6,6"
                                                        Padding="10,6"
                                                        Command="{Binding YibfModule.SelectPendingApprovalFilterCommand}"
                                                        CommandParameter="{x:Static models:YibfAnaBilgiApprovalStatuses.Incelenecek}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding YibfModule.IsPendingFilterIncelenecekSelected}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Background" Value="#FFE8EEF5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock>
                                                        <Run Text="İncelenecek ("/>
                                                        <Run Text="{Binding YibfModule.PendingFilterIncelenecekCount, Mode=OneWay}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                </Button>
                                                <Button Margin="0,0,6,6"
                                                        Padding="10,6"
                                                        Command="{Binding YibfModule.SelectPendingApprovalFilterCommand}"
                                                        CommandParameter="{x:Static models:YibfAnaBilgiApprovalStatuses.DenetcidenDonus}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding YibfModule.IsPendingFilterDenetcidenDonusSelected}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Background" Value="#FFE8EEF5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock>
                                                        <Run Text="Denetçi ("/>
                                                        <Run Text="{Binding YibfModule.PendingFilterDenetcidenDonusCount, Mode=OneWay}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                </Button>
                                                <Button Margin="0,0,6,6"
                                                        Padding="10,6"
                                                        Command="{Binding YibfModule.SelectPendingApprovalFilterCommand}"
                                                        CommandParameter="{x:Static models:YibfAnaBilgiApprovalStatuses.MuelliftenRevize}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding YibfModule.IsPendingFilterMuelliftenRevizeSelected}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Background" Value="#FFE8EEF5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock>
                                                        <Run Text="Revize ("/>
                                                        <Run Text="{Binding YibfModule.PendingFilterMuelliftenRevizeCount, Mode=OneWay}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                </Button>
                                                <Button Margin="0,0,6,6"
                                                        Padding="10,6"
                                                        Command="{Binding YibfModule.SelectPendingApprovalFilterCommand}"
                                                        CommandParameter="{x:Static models:YibfAnaBilgiApprovalStatuses.Beklenen}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding YibfModule.IsPendingFilterBeklenenSelected}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Background" Value="#FFE8EEF5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock>
                                                        <Run Text="Beklenen ("/>
                                                        <Run Text="{Binding YibfModule.PendingFilterBeklenenCount, Mode=OneWay}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                </Button>
                                                <Button Margin="0,0,6,6"
                                                        Padding="10,6"
                                                        Command="{Binding YibfModule.SelectPendingApprovalFilterCommand}"
                                                        CommandParameter="{x:Static models:YibfAnaBilgiApprovalStatuses.FilterKategorisiz}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding YibfModule.IsPendingFilterKategorisizSelected}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Background" Value="#FFE8EEF5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock>
                                                        <Run Text="Kategorisiz ("/>
                                                        <Run Text="{Binding YibfModule.PendingFilterKategorisizCount, Mode=OneWay}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                </Button>
                                            </WrapPanel>
                                            <ListBox Grid.Row="2"
                                                     ItemsSource="{Binding YibfModule.FilteredBekleyenGruplarView}"
                                                     Margin="0,8,0,0"
                                                     ScrollViewer.IsDeferredScrollingEnabled="False"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     Style="{StaticResource VirtualizedListBoxStyle}"
                                                     ItemContainerStyle="{StaticResource VirtualizedListBoxItemStyle}">
                                                <ListBox.ItemTemplate>
                                                     <DataTemplate DataType="{x:Type viewModels:YibfPendingGroupViewModel}">
                                                         <Border HorizontalAlignment="Stretch"
                                                                 Margin="0,0,0,10">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource YibfPassiveSurfaceStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#FFD64545"/>
                                                                            <Setter Property="BorderThickness" Value="2"/>
                                                                            <Setter Property="Background" Value="#14D64545"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <DockPanel Margin="0,0,0,8">
                                                                    <Border DockPanel.Dock="Right"
                                                                            Background="#FFE8EEF5"
                                                                            CornerRadius="8"
                                                                            Padding="8,4"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding EventCountText}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#FF20344C"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding TitleText}"
                                                                               FontSize="15"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#FF111111"
                                                                               TextWrapping="Wrap"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,10,0"/>
                                                                </DockPanel>
                                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleEvents}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type viewModels:YibfPendingItemViewModel}">
                                                                            <Border Margin="0,0,0,6"
                                                                                    Padding="0,0,0,0"
                                                                                    Background="Transparent"
                                                                                    Cursor="Hand"
                                                                                    behaviors:ClickCommandBehavior.Command="{Binding DataContext.YibfModule.SelectPendingItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    behaviors:ClickCommandBehavior.CommandParameter="{Binding}"
                                                                                    behaviors:DoubleClickCommandBehavior.Command="{Binding DataContext.YibfModule.EditPendingItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    behaviors:DoubleClickCommandBehavior.CommandParameter="{Binding}">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="6"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <Border Grid.Column="0"
                                                                                            Background="{Binding CategoryBrush}"
                                                                                            CornerRadius="4,0,0,4"
                                                                                            Margin="0,0,10,0"/>
                                                                                    <Border Grid.Column="1"
                                                                                            Background="#FFF8FAFC"
                                                                                            CornerRadius="0,8,8,0"
                                                                                            Padding="10,8">
                                                                                        <Grid>
                                                                                            <Grid.RowDefinitions>
                                                                                                <RowDefinition Height="Auto"/>
                                                                                                <RowDefinition Height="Auto"/>
                                                                                            </Grid.RowDefinitions>
                                                                                            <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="*"/>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <TextBlock Text="{Binding StatusLabel}"
                                                                                                           FontWeight="SemiBold"
                                                                                                           Foreground="#FF111111"
                                                                                                           TextWrapping="Wrap"
                                                                                                           VerticalAlignment="Center"/>
                                                                                                <TextBlock Grid.Column="1"
                                                                                                           Text="{Binding EventDateText}"
                                                                                                           Foreground="{StaticResource Brush.TextSecondary}"
                                                                                                           Margin="12,0,8,0"
                                                                                                           VerticalAlignment="Center"/>
                                                                                                <Border Grid.Column="2"
                                                                                                        CornerRadius="8"
                                                                                                        Padding="8,4"
                                                                                                        VerticalAlignment="Center">
                                                                                                    <Border.Style>
                                                                                                        <Style TargetType="Border">
                                                                                                            <Setter Property="Background" Value="#FFE8EEF5"/>
                                                                                                            <Style.Triggers>
                                                                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                                                                    <Setter Property="Background" Value="#FFFFCDD2"/>
                                                                                                                </DataTrigger>
                                                                                                            </Style.Triggers>
                                                                                                        </Style>
                                                                                                    </Border.Style>
                                                                                                    <TextBlock Text="{Binding DaysElapsedText}"
                                                                                                               FontWeight="SemiBold"
                                                                                                               Foreground="#FF20344C"/>
                                                                                                </Border>
                                                                                            </Grid>
                                                                                            <TextBlock Grid.Row="1"
                                                                                                       Text="{Binding Summary}"
                                                                                                       Margin="0,6,0,0"
                                                                                                       TextWrapping="Wrap"
                                                                                                       FontWeight="SemiBold"
                                                                                                       TextAlignment="Left"/>
                                                                                        </Grid>
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                         </Border>
                                                     </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
</UserControl>



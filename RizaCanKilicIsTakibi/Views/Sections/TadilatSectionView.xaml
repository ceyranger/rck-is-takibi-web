<UserControl x:Class="RizaCanKilicIsTakibi.Views.Sections.TadilatSectionView"
             x:Name="TadilatSectionRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:RizaCanKilicIsTakibi.Models"
             xmlns:viewModels="clr-namespace:RizaCanKilicIsTakibi.ViewModels"
             xmlns:behaviors="clr-namespace:RizaCanKilicIsTakibi.Behaviors"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RizaCanKilicIsTakibi;component/Views/Sections/Shared/SectionTableResources.xaml"/>
                <ResourceDictionary Source="/RizaCanKilicIsTakibi;component/Views/Sections/Shared/InlineCellResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TadilatDistrictButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FFE9EFF7"/>
                <Setter Property="Foreground" Value="#FF1B3656"/>
                <Setter Property="BorderBrush" Value="#FFBCD0E6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu>
                            <MenuItem Header="Yeni Satır Ekle"
                                      Command="{Binding PlacementTarget.Tag.AddEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.District, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TadilatSecondBarButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="TadilatSecondBarChipStyle" TargetType="Border" BasedOn="{StaticResource MissingProjectToolbarChipStyle}">
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <Style x:Key="TadilatCellBorderStyle" TargetType="Border" BasedOn="{StaticResource TadilatCellBorderStyle}">
                <Setter Property="BorderBrush" Value="#FFB7C9DE"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="5,6"/>
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <DataTemplate x:Key="TadilatCellDisplayTemplate" DataType="{x:Type viewModels:TadilatCellViewModel}">
                <TextBlock Text="{Binding Text}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Stretch"/>
            </DataTemplate>

            <DataTemplate x:Key="TadilatCellEditorTemplate" DataType="{x:Type viewModels:TadilatCellViewModel}">
                <TextBox Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                         x:Name="TadilatCellEditor"
                         Style="{StaticResource InlineEditableCellTextBoxStyle}"
                         TextAlignment="Center"
                         HorizontalContentAlignment="Center"
                         behaviors:TextBoxEditCommitBehavior.CommitCommand="{Binding DataContext.TadilatModule.CommitCellEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         behaviors:TextBoxEditCommitBehavior.CancelCommand="{Binding DataContext.TadilatModule.CancelCellEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         behaviors:TextBoxEditCommitBehavior.CommandParameter="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="TadilatCellTemplate" DataType="{x:Type viewModels:TadilatCellViewModel}">
                <Border Style="{StaticResource TadilatCellBorderStyle}"
                        Tag="{Binding DataContext.TadilatModule, RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="{Binding BackgroundBrush}"
                        behaviors:InlineEditActivatorBehavior.BeginEditCommand="{Binding DataContext.TadilatModule.BeginCellEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        behaviors:InlineEditActivatorBehavior.CommandParameter="{Binding}">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Kopyala"
                                      Command="{Binding PlacementTarget.Tag.CopyCellCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Yapıştır"
                                      Command="{Binding PlacementTarget.Tag.PasteCellCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Yukarı Taşı"
                                      Command="{Binding PlacementTarget.Tag.MoveEntryUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Aşağı Taşı"
                                      Command="{Binding PlacementTarget.Tag.MoveEntryDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="BİTEN'E TAŞI"
                                      Command="{Binding PlacementTarget.Tag.MoveToBitenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <MenuItem Header="AKTİF'E AL"
                                      Command="{Binding PlacementTarget.Tag.MoveToAktifCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <MenuItem Header="Satırı Renklendir">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                                <MenuItem Header="Kırmızı"
                                          Command="{Binding PlacementTarget.Tag.SetRowColorRedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Sarı"
                                          Command="{Binding PlacementTarget.Tag.SetRowColorYellowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Yeşil"
                                          Command="{Binding PlacementTarget.Tag.SetRowColorGreenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Mavi"
                                          Command="{Binding PlacementTarget.Tag.SetRowColorBlueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Gri"
                                          Command="{Binding PlacementTarget.Tag.SetRowColorGrayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="Rengi Temizle"
                                          Command="{Binding PlacementTarget.Tag.ClearRowColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </MenuItem>
                            <Separator>
                                <Separator.Style>
                                    <Style TargetType="Separator">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Separator.Style>
                            </Separator>
                            <MenuItem Header="Not Düzenle"
                                      Command="{Binding PlacementTarget.Tag.EditCellNoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <Separator>
                                <Separator.Style>
                                    <Style TargetType="Separator">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Separator.Style>
                            </Separator>
                            <MenuItem Header="Kırmızı"
                                      Command="{Binding PlacementTarget.Tag.SetCellColorRedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <MenuItem Header="Sarı"
                                      Command="{Binding PlacementTarget.Tag.SetCellColorYellowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <MenuItem Header="Yeşil"
                                      Command="{Binding PlacementTarget.Tag.SetCellColorGreenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <MenuItem Header="Mavi"
                                      Command="{Binding PlacementTarget.Tag.SetCellColorBlueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <MenuItem Header="Gri"
                                      Command="{Binding PlacementTarget.Tag.SetCellColorGrayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <MenuItem Header="Rengi Temizle"
                                      Command="{Binding PlacementTarget.Tag.ClearCellColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <ContentControl Content="{Binding}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TadilatCellDisplayTemplate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource TadilatCellEditorTemplate}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                        <Border Style="{StaticResource CellNoteBadgeStyle}"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="TADİLAT TAKİBİ"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="24"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Hücre rengi ve hücre notu ile ilçe bazlı takip."
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                <Button Content="Excel Dışa" Command="{Binding ExportExcelCommand}"/>
                                <Button Content="Kaydet" Command="{Binding SaveActiveTabCommand}" Style="{StaticResource GhostButton}"/>
                                <Button Content="Sil" Command="{Binding TadilatModule.DeleteEntryCommand}" Style="{StaticResource GhostButton}"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,8,0,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="AKTİF"
                                        Command="{Binding TadilatModule.SelectSubTabCommand}"
                                        CommandParameter="{x:Static models:TadilatSubTab.Aktif}"
                                        Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TadilatSecondBarButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TadilatModule.SelectedSubTab}" Value="{x:Static models:TadilatSubTab.Aktif}">
                                                    <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="BİTEN"
                                        Command="{Binding TadilatModule.SelectSubTabCommand}"
                                        CommandParameter="{x:Static models:TadilatSubTab.Biten}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TadilatSecondBarButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TadilatModule.SelectedSubTab}" Value="{x:Static models:TadilatSubTab.Biten}">
                                                    <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            behaviors:AutoScaleToWidthBehavior.IsEnabled="True"
                                            behaviors:AutoScaleToWidthBehavior.MinScale="0.70">
                                    <Button Content="BİTEN'E TAŞI"
                                            Command="{Binding TadilatModule.MoveToBitenCommand}"
                                            CommandParameter="{Binding TadilatModule.SelectedEntry}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TadilatSecondBarButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TadilatModule.SelectedSubTab}" Value="{x:Static models:TadilatSubTab.Biten}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="AKTİF'E AL"
                                            Command="{Binding TadilatModule.MoveToAktifCommand}"
                                            CommandParameter="{Binding TadilatModule.SelectedEntry}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TadilatSecondBarButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TadilatModule.SelectedSubTab}" Value="{x:Static models:TadilatSubTab.Biten}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Yukarı"
                                            Command="{Binding TadilatModule.MoveEntryUpCommand}"
                                            CommandParameter="{Binding TadilatModule.SelectedEntry}"
                                            Style="{StaticResource TadilatSecondBarButtonStyle}"/>
                                    <Button Content="Aşağı"
                                            Command="{Binding TadilatModule.MoveEntryDownCommand}"
                                            CommandParameter="{Binding TadilatModule.SelectedEntry}"
                                            Style="{StaticResource TadilatSecondBarButtonStyle}"/>
                                    <ItemsControl ItemsSource="{Binding TadilatModule.DistrictCounts}" Margin="0,0,6,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewModels:TadilatDistrictCountItem}">
                                                <Border Style="{StaticResource TadilatSecondBarChipStyle}">
                                                    <TextBlock Text="{Binding DisplayText}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="#FF20344C"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Style="{StaticResource TadilatSecondBarChipStyle}">
                                        <TextBlock Text="{Binding TadilatModule.VisibleEntryCount, StringFormat=Görünen Kayıt: {0}}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="#FF20344C"/>
                                    </Border>
                                    <Border Style="{StaticResource TadilatSecondBarChipStyle}"
                                            Visibility="{Binding TadilatModule.HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Kaydedilmemiş değişiklik var"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="#FF9B6E11"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="{x:Static SystemParameters.VerticalScrollBarWidth}"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="1.45*"/>
                                        <ColumnDefinition Width="0.82*"/>
                                        <ColumnDefinition Width="0.74*"/>
                                        <ColumnDefinition Width="0.74*"/>
                                        <ColumnDefinition Width="0.96*"/>
                                        <ColumnDefinition Width="0.92*"/>
                                        <ColumnDefinition Width="0.98*"/>
                                        <ColumnDefinition Width="0.80*"/>
                                        <ColumnDefinition Width="0.80*"/>
                                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="İLÇE" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="1" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="İŞİN İSMİ" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="2" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="TADİLAT PROJE TÜRÜ" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="3" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="PROJENİN DİJİTALİ GELDİ Mİ ?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="4" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="PROJEYİ İLGİLİ DENETÇİ ONAYLADI MI?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="5" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="PROJENİN ÇIKTISI VE TADİLAT RAPORU BÜROYA GELDİ Mİ ?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="6" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="ÜST YAZI YAZILIP BELEDİYEYE TESLİM EDİLDİ Mİ?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="7" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="PROJELER BELEDİYEDEN ALINIP ARŞİVE KONULDU MU?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="8" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="AÇIKLAMA 1" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="9" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="AÇIKLAMA 2" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                                </Grid>
                                <Border Grid.Column="1" Background="#FF16355C" BorderBrush="#FFD5E0EE" BorderThickness="0,0,1,1"/>
                            </Grid>

<ListBox Grid.Row="1"
         ItemsSource="{Binding TadilatModule.DistrictGroups}"
         behaviors:MouseWheelScrollBehavior.IsEnabled="True"
         x:Name="TadilatDistrictGroupsList"
         Style="{StaticResource VirtualizedListBoxStyle}"
         ItemContainerStyle="{StaticResource VirtualizedListBoxItemStyle}"
         ScrollViewer.IsDeferredScrollingEnabled="False"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type viewModels:TadilatDistrictGroup}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Tag="{Binding DataContext.TadilatModule, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="{Binding District}"
                        Style="{StaticResource TadilatDistrictButtonStyle}"
                        MinHeight="44"/>

                <Grid Grid.Column="1">
                    <ListBox
                         ItemsSource="{Binding Rows}"
                         behaviors:MouseWheelScrollBehavior.IsEnabled="True"
                         behaviors:MouseWheelScrollBehavior.TargetElementName="TadilatDistrictGroupsList"
                         behaviors:SynchronizedVerticalScrollBehavior.TargetElementName="TadilatDistrictGroupsList"
                         ItemContainerStyle="{StaticResource VirtualizedListBoxItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource VirtualizedListBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:TadilatEntryRow}">
                            <Border Style="{StaticResource TadilatRowBorderStyle}"
                                    Tag="{Binding IsSelected}"
                                    Margin="0,0,0,2"
                                    behaviors:ClickCommandBehavior.Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.TadilatModule.SelectEntryCommand}"
                                    behaviors:ClickCommandBehavior.CommandParameter="{Binding Entry}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.45*"/>
                                        <ColumnDefinition Width="0.82*"/>
                                        <ColumnDefinition Width="0.74*"/>
                                        <ColumnDefinition Width="0.74*"/>
                                        <ColumnDefinition Width="0.96*"/>
                                        <ColumnDefinition Width="0.92*"/>
                                        <ColumnDefinition Width="0.98*"/>
                                        <ColumnDefinition Width="0.80*"/>
                                        <ColumnDefinition Width="0.80*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Content="{Binding JobNameCell}" ContentTemplate="{StaticResource TadilatCellTemplate}"/>
                                    <ContentPresenter Grid.Column="1" Content="{Binding ProjectTypeCell}" ContentTemplate="{StaticResource TadilatCellTemplate}"/>
                                    <ContentPresenter Grid.Column="2" Content="{Binding DigitalReceivedCell}" ContentTemplate="{StaticResource TadilatCellTemplate}"/>
                                    <ContentPresenter Grid.Column="3" Content="{Binding InspectorApprovedCell}" ContentTemplate="{StaticResource TadilatCellTemplate}"/>
                                    <ContentPresenter Grid.Column="4" Content="{Binding OutputAndReportArrivedCell}" ContentTemplate="{StaticResource TadilatCellTemplate}"/>
                                    <ContentPresenter Grid.Column="5" Content="{Binding OfficialLetterSubmittedCell}" ContentTemplate="{StaticResource TadilatCellTemplate}"/>
                                    <ContentPresenter Grid.Column="6" Content="{Binding ArchivedFromMunicipalityCell}" ContentTemplate="{StaticResource TadilatCellTemplate}"/>
                                    <ContentPresenter Grid.Column="7" Content="{Binding Description1Cell}" ContentTemplate="{StaticResource TadilatCellTemplate}"/>
                                    <ContentPresenter Grid.Column="8" Content="{Binding Description2Cell}" ContentTemplate="{StaticResource TadilatCellTemplate}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Padding="14,12"
                            Background="#FFF7FAFE"
                            BorderBrush="#FFD6E3F2"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Henüz kayıt yok"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"/>
                            <Button Content="Görev Ekle"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding DataContext.TadilatModule.AddEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding District}"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
    </ListBox.ItemTemplate>
</ListBox>

                            <TextBlock Grid.Row="2"
                                       Margin="6,10,6,2"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       Text="İpucu: İlçe bloğuna sağ tıklayıp satır ekleyin. Hücreye çift tık/F2 ile yazı düzenleyin, sağ tık ile renk ve not yönetin."/>
                        </Grid>
                    </Border>
                </Grid>
</UserControl>







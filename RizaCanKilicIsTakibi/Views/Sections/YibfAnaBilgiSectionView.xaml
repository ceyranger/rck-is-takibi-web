<UserControl x:Class="RizaCanKilicIsTakibi.Views.Sections.YibfAnaBilgiSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:RizaCanKilicIsTakibi.Models"
             xmlns:viewModels="clr-namespace:RizaCanKilicIsTakibi.ViewModels"
             xmlns:behaviors="clr-namespace:RizaCanKilicIsTakibi.Behaviors"
             xmlns:viewControls="clr-namespace:RizaCanKilicIsTakibi.Views.Controls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RizaCanKilicIsTakibi;component/Views/Sections/Shared/YibfSurfaceResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
<Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PROJE TAKİBİ" FontFamily="{StaticResource Font.Primary}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource MissingProjectToolbarChipStyle}" Margin="14,0,0,0">
                        <TextBlock Text="{Binding YibfModule.TumIsler.Count, StringFormat=Toplam İş: {0}}" FontWeight="SemiBold" Foreground="#FF20344C"/>
                    </Border>
                    <Border Style="{StaticResource MissingProjectToolbarChipStyle}" Margin="8,0,0,0">
                        <TextBlock Text="{Binding YibfModule.BekleyenIsler.Count, StringFormat=Bekleyen İş: {0}}" FontWeight="SemiBold" Foreground="#FF20344C"/>
                    </Border>
                </WrapPanel>
                <TextBlock Text="Ana bilgi kartı ve olay akışı." Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Excel Dışa" Command="{Binding ExportExcelCommand}"/>
                <Button Content="Sil" Command="{Binding DeleteActiveSelectionCommand}" Style="{StaticResource GhostButton}"/>
                <Border Style="{StaticResource MissingProjectToolbarChipStyle}"
                        Visibility="{Binding YibfModule.HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Kaydedilmemiş değişiklik var" FontWeight="SemiBold" Foreground="#FF9B6E11"/>
                </Border>
            </WrapPanel>
        </DockPanel>
    </Border>

    <Grid Grid.Row="1" x:Name="YibfAnaBilgiPanel" Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.35*" MinWidth="260"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="0.65*" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="Tüm İşler" FontFamily="{StaticResource Font.Primary}" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button Content="Yeni İş Ekle" Command="{Binding YibfModule.AddAnaBilgiEntryCommand}"/>
                        <Button Content="Düzenle" Command="{Binding YibfModule.EditAnaBilgiEntryCommand}" Style="{StaticResource GhostButton}"/>
                        <Button Content="Sil" Command="{Binding YibfModule.DeleteAnaBilgiEntryCommand}" Style="{StaticResource GhostButton}"/>
                        <Button Content="Yukarı"
                                Command="{Binding YibfModule.MoveAnaBilgiEntryUpCommand}"
                                CommandParameter="{Binding YibfModule.SelectedAnaBilgiEntry}"
                                Style="{StaticResource GhostButton}"/>
                        <Button Content="Aşağı"
                                Command="{Binding YibfModule.MoveAnaBilgiEntryDownCommand}"
                                CommandParameter="{Binding YibfModule.SelectedAnaBilgiEntry}"
                                Style="{StaticResource GhostButton}"/>
                    </WrapPanel>
                </DockPanel>
                <TextBox Grid.Row="1" Margin="0,12,0,12" Height="38" Text="{Binding YibfModule.SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                <ListBox Grid.Row="2"
                         x:Name="TumIslerListBox"
                         ItemsSource="{Binding YibfModule.TumIslerView}"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Style="{StaticResource VirtualizedListBoxStyle}"
                         ItemContainerStyle="{StaticResource VirtualizedListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:YibfAnaBilgiListItemViewModel}">
                            <Border Style="{StaticResource YibfSelectableSurfaceStyle}"
                                    Tag="{Binding DataContext.YibfModule, RelativeSource={RelativeSource AncestorType=Window}}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,12,8"
                                    behaviors:ClickCommandBehavior.Command="{Binding DataContext.YibfModule.SelectAnaBilgiEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    behaviors:ClickCommandBehavior.CommandParameter="{Binding Entry}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Yukarı Taşı"
                                                  Command="{Binding PlacementTarget.Tag.MoveAnaBilgiEntryUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Aşağı Taşı"
                                                  Command="{Binding PlacementTarget.Tag.MoveAnaBilgiEntryDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="10" Height="10" Background="{Binding StatusBrush}" CornerRadius="5" Margin="0,4,10,0" VerticalAlignment="Top"/>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Entry.AdaParsel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Entry.YapiSahibi}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="2" Text="{Binding LastSummary}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Style="{StaticResource CardBorderStyle}"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding YibfModule.SelectedAnaBilgiEntry.AdaParsel, TargetNullValue=İş seçin}"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <Grid Grid.Row="1" Margin="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Ada Parsel" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding YibfModule.SelectedAnaBilgiEntry.AdaParsel}" Margin="12,0,0,0" HorizontalAlignment="Stretch" TextAlignment="Left" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Text="YİBF No" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding YibfModule.SelectedAnaBilgiEntry.YibfNo}" Margin="12,0,0,0" HorizontalAlignment="Stretch" TextAlignment="Left" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="2" Text="Belediye" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding YibfModule.SelectedAnaBilgiEntry.Idare}" Margin="12,0,0,0" HorizontalAlignment="Left" TextAlignment="Left" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="3" Text="Yapı Sahibi" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding YibfModule.SelectedAnaBilgiEntry.YapiSahibi}" Margin="12,0,0,0" HorizontalAlignment="Left" TextAlignment="Left" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="4" Text="Müteahhit" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding YibfModule.SelectedAnaBilgiEntry.Muteahhit}" Margin="12,0,0,0" HorizontalAlignment="Left" TextAlignment="Left" TextWrapping="Wrap"/>
                </Grid>
                <DockPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Olay Akışı" FontFamily="{StaticResource Font.Primary}" FontSize="17" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button Content="Olay Ekle" Command="{Binding YibfModule.AddAnaBilgiEventCommand}"/>
                        <Button Content="Düzenle" Command="{Binding YibfModule.EditAnaBilgiEventCommand}" Style="{StaticResource GhostButton}"/>
                        <Button Content="Sil" Command="{Binding YibfModule.DeleteAnaBilgiEventCommand}" Style="{StaticResource GhostButton}"/>
                    </WrapPanel>
                </DockPanel>
                <ListBox Grid.Row="3"
                         x:Name="VisibleEventsListBox"
                         ItemsSource="{Binding YibfModule.VisibleEvents}"
                         behaviors:MouseWheelScrollBehavior.IsEnabled="True"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource VirtualizedListBoxStyle}"
                         ItemContainerStyle="{StaticResource VirtualizedListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:YibfTimelineEventViewModel}">
                            <Border Style="{StaticResource YibfSelectableSurfaceStyle}"
                                    Padding="0"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                    behaviors:ClickCommandBehavior.Command="{Binding DataContext.YibfModule.SelectAnaBilgiEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    behaviors:ClickCommandBehavior.CommandParameter="{Binding Model}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Personel ata"
                                                  Command="{Binding PlacementTarget.Tag.AssignPersonnelToYibfEventCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Atamayı kaldır"
                                                  Command="{Binding PlacementTarget.Tag.RemovePersonnelFromYibfEventCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext.Model, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*" MinWidth="0"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="86"
                                            MinHeight="26"
                                            Background="{Binding AccentBrush}"
                                            CornerRadius="8"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="12,12,0,12">
                                        <TextBlock Text="{Binding DateText}"
                                                   Foreground="{Binding AccentForegroundBrush}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Grid Grid.Column="1"
                                          Margin="12,12,12,12"
                                          MinWidth="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid MinWidth="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Description}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Left"
                                                       HorizontalAlignment="Stretch"
                                                       FontWeight="SemiBold"/>
                                            <viewControls:PersonnelAssignedBadge Grid.Column="1"
                                                                                BadgeText="{Binding Model.AssignedPersonnelBadge}"
                                                                                IconVariant="TwoPeople"
                                                                                Margin="8,0,0,0"
                                                                                VerticalAlignment="Top"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding NoteText}"
                                                   Margin="0,6,0,0"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Left"
                                                   HorizontalAlignment="Stretch"
                                                   Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Grid>
</UserControl>



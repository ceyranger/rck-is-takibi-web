<UserControl x:Class="RizaCanKilicIsTakibi.Views.Sections.SettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="AYARLAR"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Yedekleme, bakım ve sıfırlama seçenekleri. Kayıt için sol paneldeki Kaydet'i kullanın."
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextSecondary}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="0,8,0,0"
                      MaxHeight="280"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Uygulama Ayarları"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <CheckBox Content="Otomatik yedekleme açık"
                                  Margin="0,14,0,0"
                                  IsChecked="{Binding AutoBackupEnabled, Mode=TwoWay}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Yedek aralığı:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <ComboBox Width="140"
                                      ItemsSource="{Binding AvailableAutoBackupIntervals}"
                                      SelectedItem="{Binding AutoBackupMinutes, Mode=TwoWay}"/>
                            <TextBlock Text="dakika"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <CheckBox Content="Veri boşsa örnek görevlerle başlat"
                                  Margin="0,12,0,0"
                                  IsChecked="{Binding SeedSampleDataOnEmpty, Mode=TwoWay}"/>
                        <TextBlock Text="Bu ayar yeni veya sıfırlanmış veritabanı için geçerlidir."
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>

                        <Separator Margin="0,16,0,12"/>
                        <TextBlock Text="Web Görüntüleme (Salt Okunur)"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Uygulama yalnızca web-view-latest.json dosyasını seçtiğiniz klasöre yazar. Google Drive Desktop ile aynı klasörü sync edin; personel paylaşılan site linkinden PIN ile görüntüler."
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                        <CheckBox Content="Kaydet sonrası web dosyası üret"
                                  Margin="0,12,0,0"
                                  IsChecked="{Binding WebViewExportEnabled, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding WebViewExportDirectoryDisplay}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="KLASÖR SEÇ"
                                    Command="{Binding PickWebViewExportDirectoryCommand}"
                                    Margin="0,0,8,8"/>
                            <Button Content="ŞİMDİ DIŞA AKTAR"
                                    Command="{Binding ExportWebViewNowCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding LastWebViewExportStatus}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Bakım Araçları"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="JSON yedek, geri yükleme ve build çıktısı temizliği."
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource Brush.TextSecondary}"/>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="JSON YEDEKLE"
                                        Command="{Binding ManualBackupCommand}"
                                        Margin="0,0,8,8"/>
                                <Button Content="JSON AKTAR"
                                        Command="{Binding ImportBackupCommand}"
                                        Style="{StaticResource GhostButton}"
                                        Margin="0,0,8,8"/>
                                <Button Content="EXCEL İÇE AKTAR (EKLE)"
                                        Command="{Binding AppendImportGenelExcelCommand}"
                                        Style="{StaticResource GhostButton}"
                                        ToolTip="GENEL İŞLER / AKSİYON / EKSİK PROJE sayfalarını mevcut kayıtlara ekler; silmez."
                                        Margin="0,0,8,8"/>
                                <Button Content="PDF RAPOR PAKETİ"
                                        Command="{Binding ExportReportPackCommand}"
                                        Style="{StaticResource GhostButton}"
                                        ToolTip="Genel, Aksiyon, Eksik, Karot ve Tadilat bölümlerini tek PDF'te üretir."
                                        Margin="0,0,8,8"/>
                                <Button Content="ÇIKTILARI TEMİZLE"
                                        Command="{Binding CleanupBuildArtifactsCommand}"
                                        Style="{StaticResource GhostButton}"
                                        Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Veri Sıfırlama"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Bu işlemler geri alınamaz. Önce neyin silineceği sorulur."
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource Brush.TextSecondary}"/>
                            <Button Content="CANLI VERİLERİ SIFIRLA"
                                    Command="{Binding ResetLiveDataCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Margin="0,16,0,8"/>
                            <TextBlock Text="SQLite içindeki tablolar boşaltılır. JSON yedekler korunur."
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       TextWrapping="Wrap"/>
                            <Button Content="VERİLERİ VE YEDEKLERİ SIFIRLA"
                                    Command="{Binding ResetAllDataAndBackupsCommand}"
                                    Margin="0,16,0,8"/>
                            <TextBlock Text="Canlı verilerle birlikte uygulamanın yönettiği otomatik JSON yedekleri de temizlenir."
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       TextWrapping="Wrap"/>

                            <Separator Margin="0,16,0,12"/>
                            <TextBlock Text="Sekme Sil"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Geri alınamaz, önce JSON yedek al."
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       TextWrapping="Wrap"/>
                            <ComboBox Margin="0,12,0,0"
                                      ItemsSource="{Binding ClearableTabs}"
                                      SelectedItem="{Binding SelectedClearTab, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"/>
                            <Button Content="SEKMEYİ SİL"
                                    Command="{Binding ClearSelectedTabCommand}"
                                    Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Proje Kataloğu"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Proje bilgileri, otomatik eşleştirme ve bağlantı yönetimi."
                               Margin="0,4,0,0"
                               Foreground="{StaticResource Brush.TextSecondary}"/>
                    <TextBlock Margin="0,8,0,0"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Warning}"
                               ToolTip="Kaydet ile ilgili değil. Mevcut verideki belirsiz / bağlanmamış kayıt sayısı."
                               Text="{Binding UnresolvedProjectLinkCount, StringFormat=Çözülmemiş bağlantı: {0}}"/>
                </StackPanel>

                <DockPanel Grid.Row="1" Margin="0,12,0,8">
                    <TextBox Width="260"
                             DockPanel.Dock="Left"
                             Margin="0,0,8,0"
                             ToolTip="Katalogda ara"
                             Text="{Binding CatalogSearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button Content="Ekle" Command="{Binding AddProjectCatalogEntryCommand}" Margin="0,0,8,8"/>
                        <Button Content="Düzenle" Command="{Binding EditProjectCatalogEntryCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                        <Button Content="Pasife Al" Command="{Binding DeactivateProjectCatalogEntryCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                        <Button Content="Proje Takibi'den doldur" Command="{Binding SeedProjectCatalogCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                        <Button Content="Eşleştirmeyi önizle" Command="{Binding ProjectLinkDryRunCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                        <Button Content="Şüphelileri çöz" Command="{Binding ResolveUnresolvedProjectLinksCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                        <Button Content="Bağlantıları uygula" Command="{Binding ApplyProjectLinksCommand}" Margin="0,0,8,8"/>
                        <Button Content="Bağlı kayıtları güncelle"
                                Command="{Binding OverwriteLinkedProjectRecordsCommand}"
                                Style="{StaticResource GhostButton}"
                                ToolTip="Seçili katalog projesine bağlı kayıtlardaki kimlik alanlarını katalog değerleriyle değiştirir."
                                Margin="0,0,8,8"/>
                    </WrapPanel>
                </DockPanel>

                <TextBlock Grid.Row="2"
                           Margin="0,0,0,8"
                           Foreground="{StaticResource Brush.Warning}"
                           TextWrapping="Wrap"
                           Text="Uyarı: Bağlı kayıtları güncelle işlemi, elle girilmiş proje kimlik bilgilerini katalog değerleriyle değiştirir; otomatik kaydetmez."/>

                <DataGrid Grid.Row="3"
                          ItemsSource="{Binding FilteredProjectCatalogListItems}"
                          SelectedItem="{Binding SelectedProjectCatalogListItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          MinHeight="120"
                          VerticalAlignment="Stretch">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Görünen Ad" Binding="{Binding DisplayName}" Width="1.4*"/>
                        <DataGridTextColumn Header="Ada Parsel" Binding="{Binding AdaParsel}" Width="*"/>
                        <DataGridTextColumn Header="Yapı Sahibi" Binding="{Binding YapiSahibi}" Width="*"/>
                        <DataGridTextColumn Header="YİBF No" Binding="{Binding YibfNo}" Width="0.8*"/>
                        <DataGridTextColumn Header="Belediye" Binding="{Binding Belediye}" Width="*"/>
                        <DataGridTextColumn Header="Müteahhit" Binding="{Binding Muteahhit}" Width="*"/>
                        <DataGridTextColumn Header="Tür" Binding="{Binding KindLabel}" Width="0.7*"/>
                        <DataGridTextColumn Header="Durum" Binding="{Binding ActiveLabel}" Width="0.6*"/>
                        <DataGridTextColumn Header="Üst Proje" Binding="{Binding ParentDisplayName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

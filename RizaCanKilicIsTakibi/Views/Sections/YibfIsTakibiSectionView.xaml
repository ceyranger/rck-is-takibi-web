<UserControl x:Class="RizaCanKilicIsTakibi.Views.Sections.YibfIsTakibiSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:RizaCanKilicIsTakibi.Models"
             xmlns:viewModels="clr-namespace:RizaCanKilicIsTakibi.ViewModels"
             xmlns:behaviors="clr-namespace:RizaCanKilicIsTakibi.Behaviors"
             xmlns:viewControls="clr-namespace:RizaCanKilicIsTakibi.Views.Controls"
             Loaded="OnLoaded"
             IsVisibleChanged="OnIsVisibleChanged"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RizaCanKilicIsTakibi;component/Views/Sections/Shared/SectionTableResources.xaml"/>
                <ResourceDictionary Source="/RizaCanKilicIsTakibi;component/Views/Sections/Shared/InlineCellResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TadilatCellBorderStyle" TargetType="Border" BasedOn="{StaticResource TadilatCellBorderStyle}">
                <Setter Property="BorderBrush" Value="#FFB7C9DE"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="5,6"/>
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <DataTemplate x:Key="YibfCellDisplayTemplate" DataType="{x:Type viewModels:YibfCellViewModel}">
                <TextBlock Text="{Binding Text}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Stretch"/>
            </DataTemplate>

            <DataTemplate x:Key="YibfCellEditorTemplate" DataType="{x:Type viewModels:YibfCellViewModel}">
                <TextBox Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InlineEditableCellTextBoxStyle}"
                         TextAlignment="Center"
                         HorizontalContentAlignment="Center"
                         behaviors:TextBoxEditCommitBehavior.CommitCommand="{Binding DataContext.YibfModule.CommitCellEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         behaviors:TextBoxEditCommitBehavior.CancelCommand="{Binding DataContext.YibfModule.CancelCellEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         behaviors:TextBoxEditCommitBehavior.CommandParameter="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="YibfCellTemplate" DataType="{x:Type viewModels:YibfCellViewModel}">
                <Border Style="{StaticResource TadilatCellBorderStyle}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="{Binding BackgroundBrush}"
                        IsEnabled="{Binding IsInteractive}"
                        behaviors:InlineEditActivatorBehavior.BeginEditCommand="{Binding DataContext.YibfModule.BeginCellEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        behaviors:InlineEditActivatorBehavior.CommandParameter="{Binding}">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Kopyala"
                                      Command="{Binding PlacementTarget.Tag.YibfModule.CopyCellCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Yapıştır"
                                      Command="{Binding PlacementTarget.Tag.YibfModule.PasteCellCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Yukarı Taşı"
                                      Command="{Binding PlacementTarget.Tag.YibfModule.MoveIsTakibiEntryUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Aşağı Taşı"
                                      Command="{Binding PlacementTarget.Tag.YibfModule.MoveIsTakibiEntryDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Not Düzenle"
                                      Command="{Binding PlacementTarget.Tag.YibfModule.EditCellNoteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Personel ata (hücre)"
                                      Command="{Binding PlacementTarget.Tag.AssignPersonnelToYibfCellCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Personel ata (satır)"
                                      Command="{Binding PlacementTarget.Tag.AssignPersonnelToYibfRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Atamayı kaldır"
                                      Command="{Binding PlacementTarget.Tag.RemovePersonnelFromYibfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Kırmızı"
                                      Command="{Binding PlacementTarget.Tag.YibfModule.SetCellColorRedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Sarı"
                                      Command="{Binding PlacementTarget.Tag.YibfModule.SetCellColorYellowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Yeşil"
                                      Command="{Binding PlacementTarget.Tag.YibfModule.SetCellColorGreenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Mavi"
                                      Command="{Binding PlacementTarget.Tag.YibfModule.SetCellColorBlueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Gri"
                                      Command="{Binding PlacementTarget.Tag.YibfModule.SetCellColorGrayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Rengi Temizle"
                                      Command="{Binding PlacementTarget.Tag.YibfModule.ClearCellColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <ContentControl Content="{Binding}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource YibfCellDisplayTemplate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource YibfCellEditorTemplate}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                        <Border Style="{StaticResource CellNoteBadgeStyle}"/>
                        <TextBlock Text="{Binding Row.Entry.AssignedPersonnelBadge}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Primary}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,2"
                                   IsHitTestVisible="False"
                                   ToolTip="{Binding Row.Entry.AssignedPersonnelBadge}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Row.Entry.HasAssignedPersonnel}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="YİBF İŞ TAKİBİ" FontFamily="{StaticResource Font.Primary}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Düz satır hücre bazlı takip." Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Excel Dışa" Command="{Binding ExportExcelCommand}"/>
                    <Button Content="PNG Aktar" Command="{Binding ExportYibfIsTakibiPngCommand}" CommandParameter="{Binding ElementName=YibfIsTakibiExportHost}" Style="{StaticResource GhostButton}"/>
                    <Button Content="Sil" Command="{Binding YibfModule.DeleteIsTakibiEntryCommand}" Style="{StaticResource GhostButton}"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,8,0,8">
            <DockPanel LastChildFill="False">
                <Border Style="{StaticResource MissingProjectToolbarChipStyle}"
                        DockPanel.Dock="Left"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Padding="0"
                        MinWidth="280"
                        Width="360">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding YibfModule.IsTakibiSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="36"
                                 Margin="8,0,0,0"
                                 VerticalContentAlignment="Center"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ToolTip="İş adı, kontrol alanları veya hücre notunda ara"/>
                        <TextBlock Grid.Column="0"
                                   IsHitTestVisible="False"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#FF8A9BB0"
                                   Text="Ara (iş adı, kontrol alanları...)">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding YibfModule.IsTakibiSearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1"
                                Content="×"
                                Command="{Binding YibfModule.ClearIsTakibiSearchCommand}"
                                MinWidth="28"
                                MinHeight="28"
                                Margin="2"
                                Padding="0"
                                FontSize="16"
                                ToolTip="Aramayı temizle"
                                Style="{StaticResource GhostButton}"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <Border Style="{StaticResource MissingProjectToolbarChipStyle}" Margin="0,0,8,0">
                        <TextBlock Text="{Binding YibfModule.IsTakibiEntryCountDisplay}"
                                   FontWeight="SemiBold"
                                   Foreground="#FF20344C"/>
                    </Border>
                    <Border Style="{StaticResource MissingProjectToolbarChipStyle}"
                            Margin="0,0,8,0"
                            Visibility="{Binding YibfModule.HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Kaydedilmemiş değişiklik var" FontWeight="SemiBold" Foreground="#FF9B6E11"/>
                    </Border>
                    <Button Content="Yukarı"
                            Command="{Binding YibfModule.MoveIsTakibiEntryUpCommand}"
                            CommandParameter="{Binding YibfModule.SelectedIsTakibiEntry}"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Aşağı"
                            Command="{Binding YibfModule.MoveIsTakibiEntryDownCommand}"
                            CommandParameter="{Binding YibfModule.SelectedIsTakibiEntry}"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Satır Ekle" Command="{Binding YibfModule.AddIsTakibiEntryCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" x:Name="YibfIsTakibiExportHost">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{x:Static SystemParameters.VerticalScrollBarWidth}"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.38*"/>
                        <ColumnDefinition Width="0.66*"/>
                        <ColumnDefinition Width="0.76*"/>
                        <ColumnDefinition Width="0.72*"/>
                        <ColumnDefinition Width="0.64*"/>
                        <ColumnDefinition Width="0.92*"/>
                        <ColumnDefinition Width="0.62*"/>
                        <ColumnDefinition Width="0.64*"/>
                        <ColumnDefinition Width="0.64*"/>
                        <ColumnDefinition Width="0.76*"/>
                        <ColumnDefinition Width="0.76*"/>
                        <ColumnDefinition Width="0.70*"/>
                        <ColumnDefinition Width="0.76*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="İŞİN İSMİ" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="1" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="MÜELLİF BİLGİLERİ GELDİ Mİ?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="2" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="DENETÇİ ATAMALARI 10 GÜN İÇİNDE YAPILDI MI?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="3" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="TÜM PROJELERİN DİJİTALİ VAR MI?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="4" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="EVRAKLAR TAM MI?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="5" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="YİBF SÖZLEŞME TAAHHÜTNAME HAZIRLANDI MI? İMZALAR TAM MI?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="6" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="DEKONT ALINDI MI?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="7" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="RUHSAT BAŞVURUSU YAPILDI MI?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="8" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="RUHSAT NÜSHASI ALINDI MI?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="9" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="İŞYERİ TESLİM TUTANAĞI HAZIRLANDI MI?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="10" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="İSG YAZISI HAZIRLANDI MI? İMZALAR TAM MI?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="11" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="SAĞLIK GÜVENLİK PLANI GELDİ Mİ?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                    <Border Grid.Column="12" Style="{StaticResource TadilatCellBorderStyle}" Background="#FF16355C" MinHeight="84"><TextBlock Text="TEMEL TOPRAKLAMA TUTANAĞI HAZIRLANDI MI?" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/></Border>
                </Grid>
                <Border Grid.Column="1" Background="#FF16355C" BorderBrush="#FFD5E0EE" BorderThickness="0,0,1,1"/>
            </Grid>

            <Grid Grid.Row="1">
                <ListBox x:Name="YibfIsTakibiListBox"
                         ItemsSource="{Binding YibfModule.IsTakibiRows}"
                         behaviors:MouseWheelScrollBehavior.IsEnabled="True"
                         Style="{StaticResource VirtualizedListBoxStyle}"
                         ItemContainerStyle="{StaticResource VirtualizedListBoxItemStyle}"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         VirtualizingPanel.CacheLength="3"
                         VirtualizingPanel.CacheLengthUnit="Item"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:YibfIsTakibiRow}">
                            <Border Style="{StaticResource TadilatRowBorderStyle}"
                                    Tag="{Binding IsSelected}"
                                    Margin="0,0,0,2"
                                    behaviors:ClickCommandBehavior.Command="{Binding DataContext.YibfModule.SelectIsTakibiEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    behaviors:ClickCommandBehavior.CommandParameter="{Binding Entry}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.38*"/>
                                        <ColumnDefinition Width="0.66*"/>
                                        <ColumnDefinition Width="0.76*"/>
                                        <ColumnDefinition Width="0.72*"/>
                                        <ColumnDefinition Width="0.64*"/>
                                        <ColumnDefinition Width="0.92*"/>
                                        <ColumnDefinition Width="0.62*"/>
                                        <ColumnDefinition Width="0.64*"/>
                                        <ColumnDefinition Width="0.64*"/>
                                        <ColumnDefinition Width="0.76*"/>
                                        <ColumnDefinition Width="0.76*"/>
                                        <ColumnDefinition Width="0.70*"/>
                                        <ColumnDefinition Width="0.76*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Content="{Binding JobNameCell}" ContentTemplate="{StaticResource YibfCellTemplate}"/>
                                    <ContentPresenter Grid.Column="1" Content="{Binding MuellifCell}" ContentTemplate="{StaticResource YibfCellTemplate}"/>
                                    <ContentPresenter Grid.Column="2" Content="{Binding DenetciCell}" ContentTemplate="{StaticResource YibfCellTemplate}"/>
                                    <ContentPresenter Grid.Column="3" Content="{Binding TumDijitalCell}" ContentTemplate="{StaticResource YibfCellTemplate}"/>
                                    <ContentPresenter Grid.Column="4" Content="{Binding EvrakCell}" ContentTemplate="{StaticResource YibfCellTemplate}"/>
                                    <ContentPresenter Grid.Column="5" Content="{Binding SozlesmeCell}" ContentTemplate="{StaticResource YibfCellTemplate}"/>
                                    <ContentPresenter Grid.Column="6" Content="{Binding DekontCell}" ContentTemplate="{StaticResource YibfCellTemplate}"/>
                                    <ContentPresenter Grid.Column="7" Content="{Binding RuhsatBasvuruCell}" ContentTemplate="{StaticResource YibfCellTemplate}"/>
                                    <ContentPresenter Grid.Column="8" Content="{Binding RuhsatNushaCell}" ContentTemplate="{StaticResource YibfCellTemplate}"/>
                                    <ContentPresenter Grid.Column="9" Content="{Binding IsyeriTeslimCell}" ContentTemplate="{StaticResource YibfCellTemplate}"/>
                                    <ContentPresenter Grid.Column="10" Content="{Binding IsgCell}" ContentTemplate="{StaticResource YibfCellTemplate}"/>
                                    <ContentPresenter Grid.Column="11" Content="{Binding SaglikCell}" ContentTemplate="{StaticResource YibfCellTemplate}"/>
                                    <ContentPresenter Grid.Column="12" Content="{Binding TopraklamaCell}" ContentTemplate="{StaticResource YibfCellTemplate}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Background="#CCFFFFFF"
                        Visibility="{Binding YibfModule.HasNoVisibleIsTakibiResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Arama sonucu bulunamadı. Verileriniz silinmedi; aramayı temizleyerek tüm kayıtları görebilirsiniz."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2"
                       Margin="6,10,6,2"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       Text="İpucu: Üstteki arama kutusuyla satırları filtreleyin. Hücreye çift tık/F2 ile düzenleme açılır; sağ tık menüsü ile renk ve not yönetilir."/>
        </Grid>
    </Grid>
</UserControl>

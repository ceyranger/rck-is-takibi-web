<Window x:Class="RizaCanKilicIsTakibi.Views.PersonnelAssignmentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Görev Düzenle"
        Width="520"
        Height="640"
        MinWidth="460"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Brush.EntryDialogBackground}">
    <Grid Background="{StaticResource Brush.EntryDialogBackground}">
        <Border Style="{StaticResource EntryDialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource EntryDialogHeaderStyle}">
                    <StackPanel>
                        <TextBlock Text="PERSONEL GÖREV TAKİBİ" Style="{StaticResource EntryDialogEyebrowStyle}"/>
                        <TextBlock Text="Görevi düzenle" Style="{StaticResource EntryDialogTitleStyle}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1"
                              Margin="20,14,20,8"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="KAYNAK SEKME" Style="{StaticResource EntryFieldLabelStyle}"/>
                        <Border Style="{StaticResource EntryFieldBoxStyle}" Background="#FFF1F5F9">
                            <TextBlock Text="{Binding ModuleLabel}"
                                       Padding="10,10"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <TextBlock Text="PERSONEL" Style="{StaticResource EntryFieldLabelStyle}" Margin="0,12,0,0"/>
                        <Border Style="{StaticResource EntryFieldBoxStyle}">
                            <ComboBox ItemsSource="{Binding PersonnelOptions}"
                                      SelectedItem="{Binding SelectedPersonnel, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="4"
                                      MinHeight="34"/>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DURUM" Style="{StaticResource EntryFieldLabelStyle}"/>
                                <Border Style="{StaticResource EntryFieldBoxStyle}">
                                    <ComboBox ItemsSource="{Binding StatusOptions}"
                                              SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              Margin="4"
                                              MinHeight="34"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ÖNCELİK" Style="{StaticResource EntryFieldLabelStyle}"/>
                                <Border Style="{StaticResource EntryFieldBoxStyle}">
                                    <ComboBox ItemsSource="{Binding PriorityOptions}"
                                              SelectedItem="{Binding SelectedPriority, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              Margin="4"
                                              MinHeight="34"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="İŞ ÖZETİ" Style="{StaticResource EntryFieldLabelStyle}" Margin="0,12,0,0"/>
                        <Border Style="{StaticResource EntryFieldBoxStyle}">
                            <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="72"
                                     Padding="10,8"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <TextBlock Text="ALAN" Style="{StaticResource EntryFieldLabelStyle}" Margin="0,12,0,0"/>
                        <Border Style="{StaticResource EntryFieldBoxStyle}">
                            <TextBox Text="{Binding FieldLabel, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8"
                                     MinHeight="34"
                                     VerticalContentAlignment="Center"/>
                        </Border>

                        <TextBlock Text="PROJE" Style="{StaticResource EntryFieldLabelStyle}" Margin="0,12,0,0"/>
                        <Border Style="{StaticResource EntryFieldBoxStyle}">
                            <TextBox Text="{Binding ProjectIdentity, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8"
                                     MinHeight="34"
                                     VerticalContentAlignment="Center"/>
                        </Border>

                        <TextBlock Text="ATANMA" Style="{StaticResource EntryFieldLabelStyle}" Margin="0,12,0,0"/>
                        <Border Style="{StaticResource EntryFieldBoxStyle}" Background="#FFF8FAFC">
                            <TextBlock Text="{Binding AssignedAtText}"
                                       Padding="10,10"
                                       Foreground="{StaticResource Brush.TextSecondary}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Style="{StaticResource EntryDialogFooterStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="İptal"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource GhostButton}"
                                Width="100"
                                Height="36"
                                Margin="0,0,8,0"
                                IsCancel="True"/>
                        <Button Content="Kaydet"
                                Command="{Binding SaveCommand}"
                                Width="110"
                                Height="36"
                                IsDefault="True"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="RizaCanKilicIsTakibi.Views.YibfAnaBilgiEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:RizaCanKilicIsTakibi.Behaviors"
        Title="Ana Bilgi Olayı"
        Width="580"
        Height="520"
        MinWidth="520"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Brush.AppBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ana Bilgi Olayı"
                   FontFamily="{StaticResource Font.Primary}"
                   FontWeight="SemiBold"
                   FontSize="22"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Tarih" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <DockPanel Grid.Column="1" Margin="8,0,0,0" LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Bugün"
                        MinWidth="72"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding SetTodayCommand}"/>
                <DatePicker SelectedDate="{Binding EventDate, Mode=TwoWay}"
                            FontSize="15"
                            Padding="8,6"
                            MinHeight="36"
                            VerticalContentAlignment="Center"/>
            </DockPanel>

            <TextBlock Grid.Row="1" Text="Durum" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,12,0,0"/>
            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      Margin="8,12,0,0"
                      MinHeight="36"
                      Padding="8,6"
                      ItemsSource="{Binding ApprovalStatusOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedApprovalStatus, Mode=TwoWay}"/>

            <TextBlock Grid.Row="2" Text="Renk" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,12,0,0"/>
            <ComboBox Grid.Row="2"
                      Grid.Column="1"
                      Margin="8,12,0,0"
                      MinHeight="36"
                      Padding="8,6"
                      ItemsSource="{Binding ColorOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedColor, Mode=TwoWay}"
                      IsEnabled="{Binding IsColorEditable}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Açıklama" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,6,0,0"
                     Padding="10"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     behaviors:TextBoxMouseWheelBehavior.IsEnabled="True"
                     MinHeight="96"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Not" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1"
                     Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,6,0,0"
                     Padding="10"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     behaviors:TextBoxMouseWheelBehavior.IsEnabled="True"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="İptal"
                    Width="96"
                    Margin="0,0,8,0"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Kaydet"
                    Width="120"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="RizaCanKilicIsTakibi.Views.YibfAnaBilgiEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:RizaCanKilicIsTakibi.Behaviors"
        Title="Ana Bilgi Olayı"
        Width="620"
        Height="600"
        MinWidth="560"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FFEEF3F9">
    <Grid Background="{StaticResource Brush.EntryDialogBackground}">
        <Border Style="{StaticResource EntryDialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource EntryDialogHeaderStyle}">
                    <StackPanel>
                        <TextBlock Text="ANA BİLGİ OLAYI" Style="{StaticResource EntryDialogEyebrowStyle}"/>
                        <TextBlock Text="Olay kaydı" Style="{StaticResource EntryDialogTitleStyle}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="20,14,20,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="TARİH" Style="{StaticResource EntryFieldLabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource EventFieldBoxStyle}" MinHeight="38">
                                <DatePicker SelectedDate="{Binding EventDate, Mode=TwoWay}"
                                            Style="{StaticResource EntryFieldDatePickerStyle}"/>
                            </Border>
                            <Button Grid.Column="1"
                                    Content="Bugün"
                                    MinWidth="80"
                                    MinHeight="38"
                                    Margin="8,0,0,0"
                                    Padding="12,6"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding SetTodayCommand}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="DURUM" Style="{StaticResource EntryFieldLabelStyle}"/>
                        <Border Style="{StaticResource EventFieldBoxStyle}" MinHeight="38">
                            <ComboBox BorderThickness="0"
                                      Background="Transparent"
                                      FontSize="13"
                                      Padding="8,6"
                                      VerticalContentAlignment="Center"
                                      Margin="0"
                                      ItemsSource="{Binding ApprovalStatusOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedApprovalStatus, Mode=TwoWay}"/>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="AÇIKLAMA" Style="{StaticResource EntryFieldLabelStyle}"/>
                        <Border Grid.Row="1" Style="{StaticResource EventFieldBoxStyle}">
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EntryFieldMultilineTextBoxStyle}"
                                     behaviors:TextBoxMouseWheelBehavior.IsEnabled="True"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="NOT" Style="{StaticResource EntryFieldLabelStyle}"/>
                        <Border Grid.Row="1" Style="{StaticResource EventFieldBoxStyle}">
                            <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EntryFieldMultilineTextBoxStyle}"
                                     behaviors:TextBoxMouseWheelBehavior.IsEnabled="True"/>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource EntryDialogFooterStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="İptal"
                                Width="100"
                                Margin="0,0,8,0"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding CancelCommand}"/>
                        <Button Content="Kaydet"
                                Width="120"
                                Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

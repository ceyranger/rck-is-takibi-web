<Window x:Class="RizaCanKilicIsTakibi.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:RizaCanKilicIsTakibi.Models"
        xmlns:viewModels="clr-namespace:RizaCanKilicIsTakibi.ViewModels"
        xmlns:converters="clr-namespace:RizaCanKilicIsTakibi.Converters"
        xmlns:behaviors="clr-namespace:RizaCanKilicIsTakibi.Behaviors"
        xmlns:controls="clr-namespace:RizaCanKilicIsTakibi.Controls"
        xmlns:viewControls="clr-namespace:RizaCanKilicIsTakibi.Views.Controls"
        xmlns:sections="clr-namespace:RizaCanKilicIsTakibi.Views.Sections"
        mc:Ignorable="d"
        Title="RIZA CAN KILIÇ İŞ TAKİBİ PROGRAMI"
        Height="900"
        Width="1560"
        MinHeight="780"
        MinWidth="1300"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <Style x:Key="TaskBoardEditingTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource WrappedCellEditingTextBoxStyle}">
            <Setter Property="behaviors:TextChangedCommandBehavior.Command"
                    Value="{Binding DataContext.CommitGeneralEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Style>
        <Style x:Key="TaskBoardSelectableTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>
        <Style x:Key="TaskBoardDragHandleStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="⠿"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#FF7A8DA3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="ToolTip" Value="Sürükleyerek diğer listeye taşı"/>
            <Setter Property="behaviors:DataGridDragDropBehavior.IsDragHandle" Value="True"/>
        </Style>
        <Style x:Key="TaskBoardHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Background" Value="#FFF5F8FC"/>
            <Setter Property="Foreground" Value="#FF17324D"/>
            <Setter Property="BorderBrush" Value="#FFD7E1EC"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="TaskBoardGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HeadersVisibility" Value="None"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#00FFFFFF"/>
            <Setter Property="VerticalGridLinesBrush" Value="#00FFFFFF"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource TaskBoardHeaderStyle}"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="RowBackground" Value="#FFFFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#FFFCFDFF"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <Style x:Key="TaskBoardCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#FF112645"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TaskBoardRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowBorder"
                                Margin="{TemplateBinding Margin}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#FFD1DAE6"
                                BorderThickness="1"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </SelectiveScrollingGrid.RowDefinitions>
                                <DataGridCellsPresenter Grid.Column="0"
                                                        Margin="4"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <DataGridDetailsPresenter Grid.Row="1"
                                                          Visibility="{TemplateBinding DetailsVisibility}"
                                                          SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                            </SelectiveScrollingGrid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#FFF6F9FD"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#FFC7D6E7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#FFEFF4FF"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#FFABC2E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FFFCFDFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF6F9FD"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFEFF4FF"/>
                    <Setter Property="Foreground" Value="#FF112645"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

<Style x:Key="MissingProjectHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Background" Value="#FF132338"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2C3E58"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MissingProjectWebGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFD7E1EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE7EDF5"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFE1E8F2"/>
            <Setter Property="RowBackground" Value="#FFFFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#FFFAFCFF"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserResizeRows" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="ColumnHeaderHeight" Value="44"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>

        <Style x:Key="MissingProjectWebCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="BorderBrush" Value="#FFE1E8F2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="#FF5F84C7"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE6EEFC"/>
                    <Setter Property="Foreground" Value="#FF102746"/>
                    <Setter Property="BorderBrush" Value="#FFAEC2E7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MissingProjectWebRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FFFAFCFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF2F7FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFEAF1FD"/>
                    <Setter Property="Foreground" Value="#FF112645"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MissingProjectInlineCellTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="IsTabStop" Value="True"/>
                    <Setter Property="Cursor" Value="IBeam"/>
                    <Setter Property="Background" Value="#12FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MissingProjectNoteBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="CornerRadius" Value="4.5"/>
            <Setter Property="Background" Value="#FF1D5AA6"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,4,4,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="ToolTip" Value="{Binding NoteText}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasNote}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="MissingProjectCellTemplate">
            <Border Background="{Binding BackgroundBrush}"
                    Tag="{Binding DataContext.MissingProjectModule, RelativeSource={RelativeSource AncestorType=Window}}"
                    SnapsToDevicePixels="True"
                    behaviors:InlineEditActivatorBehavior.BeginEditCommand="{Binding DataContext.MissingProjectModule.BeginCellEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    behaviors:InlineEditActivatorBehavior.CommandParameter="{Binding}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Üste Satır Ekle"
                                  Command="{Binding PlacementTarget.Tag.InsertEntryAboveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Alta Satır Ekle"
                                  Command="{Binding PlacementTarget.Tag.InsertEntryBelowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Yukarı Taşı"
                                  Command="{Binding PlacementTarget.Tag.MoveEntryUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Aşağı Taşı"
                                  Command="{Binding PlacementTarget.Tag.MoveEntryDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext.Row.Entry, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Kopyala"
                                  Command="{Binding PlacementTarget.Tag.CopyCellCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Yapıştır"
                                  Command="{Binding PlacementTarget.Tag.PasteCellCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <TextBox Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MissingProjectInlineCellTextBoxStyle}"
                             behaviors:TextBoxEditCommitBehavior.CommitCommand="{Binding DataContext.MissingProjectModule.CommitCellEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                             behaviors:TextBoxEditCommitBehavior.CancelCommand="{Binding DataContext.MissingProjectModule.CancelCellEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                             behaviors:TextBoxEditCommitBehavior.CommandParameter="{Binding}"/>
                    <Border Style="{StaticResource MissingProjectNoteBadgeStyle}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="CenterWrappedCellTextBlockStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CenterWrappedCellTextBoxStyle" TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CenterCellTextBlockStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CenterCellTextBoxStyle" TargetType="TextBox">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <DataTemplate x:Key="ColumnFilterHeaderTemplate" DataType="{x:Type viewModels:ColumnFilterViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="0,0,6,0"
                           Text="{Binding Header}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Stretch"/>

                <ToggleButton x:Name="HeaderFilterButton"
                              Grid.Column="1"
                              Width="20"
                              Height="20"
                              Focusable="False"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              Padding="0">
                    <TextBlock Text="▼"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilteredOrSorted}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFF2A8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ToggleButton>

                <Popup Placement="Bottom"
                       PlacementTarget="{Binding ElementName=HeaderFilterButton}"
                       IsOpen="{Binding IsChecked, ElementName=HeaderFilterButton, Mode=TwoWay}"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Width="280"
                            Padding="10"
                            Background="White"
                            BorderBrush="#FFD0DBEA"
                            BorderThickness="1"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <StackPanel>
                            <TextBlock Text="{Binding Header}"
                                       FontWeight="SemiBold"
                                       Foreground="#FF0E1A2A"
                                       Margin="0,0,0,8"/>

                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="A-Z"
                                        Command="{Binding SortAscendingCommand}"
                                        Margin="0,0,6,6"
                                        Padding="10,4"
                                        MinWidth="56"/>
                                <Button Content="Z-A"
                                        Command="{Binding SortDescendingCommand}"
                                        Margin="0,0,6,6"
                                        Padding="10,4"
                                        MinWidth="56"/>
                                <Button Content="Sıfırla"
                                        Command="{Binding ClearSortCommand}"
                                        Margin="0,0,0,6"
                                        Padding="10,4"
                                        MinWidth="68"/>
                            </WrapPanel>

                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>

                            <CheckBox Content="Boşları dahil et"
                                      IsChecked="{Binding IncludeBlanks}"
                                      Margin="0,0,0,8"/>

                            <DockPanel Margin="0,0,0,8">
                                <Button Content="Tümünü seç"
                                        Command="{Binding SelectAllCommand}"
                                        DockPanel.Dock="Left"
                                        Margin="0,0,6,0"
                                        Padding="10,4"/>
                                <Button Content="Temizle"
                                        Command="{Binding ClearSelectionCommand}"
                                        DockPanel.Dock="Left"
                                        Padding="10,4"/>
                            </DockPanel>

                            <Border BorderBrush="#FFE2E8F2"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4">
                                <ScrollViewer MaxHeight="220"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding OptionsView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Value}"
                                                          IsChecked="{Binding IsSelected}"
                                                          Margin="2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

        <Style x:Key="KarotHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Background" Value="#FF3E6DBA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2B5292"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Stretch"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KarotGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFB9C8E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFC6D3E6"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFC6D3E6"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserResizeRows" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="ColumnHeaderHeight" Value="64"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>

        <Style x:Key="KarotCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="BorderBrush" Value="#FFC6D3E6"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF081526"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#40FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#FF173967"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#FF173967"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KarotRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Foreground" Value="#FF081526"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="#FFDCE8FF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:KarotStatus.KarotAlinacak}">
                    <Setter Property="Background" Value="#FFF6C2C2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:KarotStatus.KarotAlindiSonucBekleniyor}">
                    <Setter Property="Background" Value="#FFF8E6A8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:KarotStatus.KarotAlindiOlumlu}">
                    <Setter Property="Background" Value="#FFBBD2FF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:KarotStatus.KarotAlindiOlumsuz}">
                    <Setter Property="Background" Value="#FFF6C2C2"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF04111F"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#FF04111F"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KarotDisplayTextBlockStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource CenterWrappedCellTextBlockStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsEditing}"
                             Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KarotEditingTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource CenterWrappedCellTextBoxStyle}">
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
        </Style>
</Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding OpenSearchCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveActiveTabCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding ManualBackupCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteActiveSelectionCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}"/>
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <Border BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,8"
                            Margin="0,0,0,10"
                            Background="#FFF8FAFC">
                        <StackPanel>
                            <TextBlock Text="{Binding SaveStatusText}"
                                       FontSize="12"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnyUnsavedChanges}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding SaveStatusTimestampText}"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.TextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Button Content="AYARLAR"
                            Command="{Binding SelectMainTabCommand}"
                            CommandParameter="{x:Static models:MainNavigationTab.Ayarlar}"

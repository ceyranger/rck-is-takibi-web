                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMainTab}" Value="{x:Static models:MainNavigationTab.Ayarlar}">
                                        <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Button Content="ACİL İŞ ÖZET" Command="{Binding SelectMainTabCommand}" CommandParameter="{x:Static models:MainNavigationTab.YibfBekleyenIsler}" Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMainTab}" Value="{x:Static models:MainNavigationTab.YibfBekleyenIsler}">
                                        <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="TÜM EKSİKLER" Command="{Binding SelectMainTabCommand}" CommandParameter="{x:Static models:MainNavigationTab.TumEksikler}" Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMainTab}" Value="{x:Static models:MainNavigationTab.TumEksikler}">
                                        <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="GENEL İŞ TAKİBİ" Command="{Binding SelectMainTabCommand}" CommandParameter="{x:Static models:MainNavigationTab.GenelIsTakibi}" Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMainTab}" Value="{x:Static models:MainNavigationTab.GenelIsTakibi}">
                                        <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="ARAMA" Command="{Binding SelectMainTabCommand}" CommandParameter="{x:Static models:MainNavigationTab.Arama}" Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMainTab}" Value="{x:Static models:MainNavigationTab.Arama}">
                                        <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="AKSİYON" Command="{Binding SelectMainTabCommand}" CommandParameter="{x:Static models:MainNavigationTab.Aksiyon}" Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMainTab}" Value="{x:Static models:MainNavigationTab.Aksiyon}">
                                        <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="EKSİK PROJE" Command="{Binding SelectMainTabCommand}" CommandParameter="{x:Static models:MainNavigationTab.EksikProje}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMainTab}" Value="{x:Static models:MainNavigationTab.EksikProje}">
                                        <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="KAROT TAKİBİ" Command="{Binding SelectMainTabCommand}" CommandParameter="{x:Static models:MainNavigationTab.KarotTakibi}" Margin="0,8,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMainTab}" Value="{x:Static models:MainNavigationTab.KarotTakibi}">
                                        <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="TADİLAT TAKİBİ" Command="{Binding SelectMainTabCommand}" CommandParameter="{x:Static models:MainNavigationTab.TadilatTakibi}" Margin="0,8,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMainTab}" Value="{x:Static models:MainNavigationTab.TadilatTakibi}">
                                        <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="YİBF ANA BİLGİ" Command="{Binding SelectMainTabCommand}" CommandParameter="{x:Static models:MainNavigationTab.YibfAnaBilgi}" Margin="0,8,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMainTab}" Value="{x:Static models:MainNavigationTab.YibfAnaBilgi}">
                                        <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="YİBF İŞ TAKİBİ" Command="{Binding SelectMainTabCommand}" CommandParameter="{x:Static models:MainNavigationTab.YibfIsTakibi}" Margin="0,8,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMainTab}" Value="{x:Static models:MainNavigationTab.YibfIsTakibi}">
                                        <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedMainTab}" Value="{x:Static models:MainNavigationTab.GenelIsTakibi}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                        <DockPanel>
                            <TextBlock Text="GENEL İŞ TAKİBİ" FontFamily="{StaticResource Font.Primary}" FontSize="24" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                <Button Content="Ara" Command="{Binding OpenGlobalSearchCommand}" Style="{StaticResource GhostButton}" ToolTip="Arama sekmesine git (Ctrl+F)"/>
                                <Button Content="Kaydet" Command="{Binding SaveActiveTabCommand}" ToolTip="Kaydet (Ctrl+S)"/>
                                <Button Content="Excel Dışa" Command="{Binding ExportExcelCommand}" ToolTip="Excel'e Aktar"/>
                                <Button Content="Excel İçe (Ekle)" Command="{Binding AppendImportGenelExcelCommand}" Style="{StaticResource GhostButton}" ToolTip="Mevcut kayıtlara Excel'den ekler; silmez"/>
                                <Button Content="PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource GhostButton}" ToolTip="PDF Oluştur"/>
                                <Button Content="PDF Paket" Command="{Binding ExportReportPackCommand}" Style="{StaticResource GhostButton}" ToolTip="Çok bölümlü PDF rapor paketi"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,8,0,8">
                        <Border Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock Text="Toplam" Style="{StaticResource MetricLabelText}"/><TextBlock Text="{Binding Dashboard.TotalJobs}" Style="{StaticResource MetricValueText}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock Text="Acil" Style="{StaticResource MetricLabelText}"/><TextBlock Text="{Binding Dashboard.UrgentJobs}" Style="{StaticResource MetricValueText}" Foreground="{StaticResource Brush.Danger}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock Text="Genel" Style="{StaticResource MetricLabelText}"/><TextBlock Text="{Binding Dashboard.GeneralJobs}" Style="{StaticResource MetricValueText}" Foreground="{StaticResource Brush.Primary}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock Text="Not Sayısı" Style="{StaticResource MetricLabelText}"/><TextBlock Text="{Binding Dashboard.TotalNotes}" Style="{StaticResource MetricValueText}" Foreground="{StaticResource Brush.Success}"/></StackPanel></Border>
                    </UniformGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" CornerRadius="20">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Acil İşler" FontFamily="{StaticResource Font.Primary}" FontWeight="SemiBold" FontSize="16" DockPanel.Dock="Left"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="Hızlı" Command="{Binding OpenQuickUrgentTaskDialogCommand}" Style="{StaticResource GhostButton}" ToolTip="Şablondan Hızlı İş Ekle"/>
                                        <Button Content="+" Command="{Binding AddUrgentTaskCommand}" Style="{StaticResource IconButton}" ToolTip="Yeni Görev Ekle"/>
                                        <Button Content="Sil" Command="{Binding DeleteUrgentTaskCommand}" Style="{StaticResource GhostButton}" ToolTip="Seçili Görevi Sil (Delete)"/>
                                        <Button Content="↑" Command="{Binding MoveTaskUpCommand}" Style="{StaticResource IconButton}" ToolTip="Yukarı Taşı"/>
                                        <Button Content="↓" Command="{Binding MoveTaskDownCommand}" Style="{StaticResource IconButton}" ToolTip="Aşağı Taşı"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid Grid.Row="1"
                                          x:Name="UrgentGrid"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          Style="{StaticResource TaskBoardGridStyle}"
                                          CellStyle="{StaticResource TaskBoardCellStyle}"
                                          Margin="0,-2,0,0"
                                          ScrollViewer.IsDeferredScrollingEnabled="False"
                                          ItemsSource="{Binding UrgentBoard.TasksView}"
                                          SelectedItem="{Binding UrgentBoard.SelectedTask, Mode=TwoWay}"
                                          behaviors:DataGridClearSelectionOnEmptyClickBehavior.IsEnabled="True"
                                          behaviors:DataGridDragDropBehavior.IsEnabled="True"
                                          behaviors:DataGridDragDropBehavior.MoveTaskCommand="{Binding MoveTaskToBoardCommand}"
                                          behaviors:DataGridDragDropBehavior.TargetBoardType="{x:Static models:TaskBoardType.Acil}"
                                         behaviors:DataGridEditActivationBehavior.IsEnabled="True">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource TaskBoardRowStyle}"/>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="28" CanUserResize="False" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent"
                                                            Padding="2,0"
                                                            behaviors:DataGridDragDropBehavior.IsDragHandle="True"
                                                            Cursor="SizeAll"
                                                            ToolTip="Sürükleyerek diğer listeye taşı">
                                                        <TextBlock Style="{StaticResource TaskBoardDragHandleStyle}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Başlık"
                                                                HeaderTemplate="{StaticResource ColumnFilterHeaderTemplate}"
                                                                Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Title, Mode=OneWay}"
                                                             Style="{StaticResource TaskBoardSelectableTextBoxStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource TaskBoardEditingTextBoxStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource CardBorderStyle}"
                                CornerRadius="20"
                                UseLayoutRounding="True"
                                SnapsToDevicePixels="True"
                                RenderOptions.ClearTypeHint="Enabled"
                                TextOptions.TextFormattingMode="Display"
                                TextOptions.TextRenderingMode="ClearType">
                            <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Genel İşler" FontFamily="{StaticResource Font.Primary}" FontWeight="SemiBold" FontSize="16" DockPanel.Dock="Left"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="+" Command="{Binding AddGeneralTaskCommand}" Style="{StaticResource IconButton}" ToolTip="Yeni Görev Ekle"/>
                                        <Button Content="Sil" Command="{Binding DeleteGeneralTaskCommand}" Style="{StaticResource GhostButton}" ToolTip="Seçili Görevi Sil (Delete)"/>
                                        <Button Content="↑" Command="{Binding MoveTaskUpCommand}" Style="{StaticResource IconButton}" ToolTip="Yukarı Taşı"/>
                                        <Button Content="↓" Command="{Binding MoveTaskDownCommand}" Style="{StaticResource IconButton}" ToolTip="Aşağı Taşı"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid Grid.Row="1"
                                           x:Name="GeneralGrid"
                                           VirtualizingPanel.IsVirtualizing="True"
                                           VirtualizingPanel.VirtualizationMode="Recycling"
                                           Style="{StaticResource TaskBoardGridStyle}"
                                           CellStyle="{StaticResource TaskBoardCellStyle}"
                                           Margin="0,-2,0,0"
                                           ScrollViewer.IsDeferredScrollingEnabled="False"
                                           UseLayoutRounding="True"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.ClearTypeHint="Enabled"
                                          TextOptions.TextFormattingMode="Display"
                                           TextOptions.TextRenderingMode="ClearType"
                                           ItemsSource="{Binding GeneralBoard.TasksView}"
                                           SelectedItem="{Binding GeneralBoard.SelectedTask, Mode=TwoWay}"
                                           behaviors:DataGridClearSelectionOnEmptyClickBehavior.IsEnabled="True"
                                           behaviors:DataGridEditActivationBehavior.IsEnabled="True"
                                           behaviors:DataGridDragDropBehavior.IsEnabled="True"
                                           behaviors:DataGridDragDropBehavior.MoveTaskCommand="{Binding MoveTaskToBoardCommand}"
                                           behaviors:DataGridDragDropBehavior.TargetBoardType="{x:Static models:TaskBoardType.Genel}">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource TaskBoardRowStyle}"/>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="28" CanUserResize="False" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent"
                                                            Padding="2,0"
                                                            behaviors:DataGridDragDropBehavior.IsDragHandle="True"
                                                            Cursor="SizeAll"
                                                            ToolTip="Sürükleyerek diğer listeye taşı">
                                                        <TextBlock Style="{StaticResource TaskBoardDragHandleStyle}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Başlık"
                                                                HeaderTemplate="{StaticResource ColumnFilterHeaderTemplate}"
                                                                Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Title, Mode=OneWay}"
                                                             Style="{StaticResource TaskBoardSelectableTextBoxStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource TaskBoardEditingTextBoxStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Görev Detayı" FontFamily="{StaticResource Font.Primary}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                                <TextBlock Text="Görev seçilmedi." Foreground="{StaticResource Brush.TextSecondary}" Visibility="{Binding DetailPanel.CurrentTask, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                                <StackPanel Visibility="{Binding DetailPanel.HasTask, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Başlık" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding DetailPanel.CurrentTask.Title, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"
                                             MinHeight="42"
                                             Padding="10,8"
                                             behaviors:TextChangedCommandBehavior.Command="{Binding CommitGeneralEditCommand}"
                                             behaviors:TextBoxEditCommitBehavior.CommitCommand="{Binding CommitGeneralEditCommand}"/>
                                    <CheckBox Content="Özel iş"
                                              Margin="0,10,0,0"
                                              IsChecked="{Binding DetailPanel.CurrentTask.IsSpecialJob, Mode=TwoWay}"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="Proje" FontWeight="SemiBold"/>
                                        <viewControls:ProjectPickerControl Margin="0,4,0,0"
                                                                           Catalog="{Binding ProjectCatalogEntries}"
                                                                           SelectedProjectId="{Binding DetailPanel.CurrentTask.ProjectId, Mode=TwoWay}">
                                            <viewControls:ProjectPickerControl.Style>
                                                <Style TargetType="viewControls:ProjectPickerControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DetailPanel.CurrentTask.IsSpecialJob}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </viewControls:ProjectPickerControl.Style>
                                        </viewControls:ProjectPickerControl>
                                    </StackPanel>
                                    <TextBlock Text="Notlar" FontWeight="SemiBold" Margin="0,10,0,2"/>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                        <Button Content="Not Ekle"
                                                Command="{Binding DetailPanel.AddNoteCommand}"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource GhostButton}"/>
                                        <TextBox Text="{Binding DetailPanel.NewNoteText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="42"
                                                 Margin="0,4,6,4"/>
                                    </DockPanel>
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="6" Background="{StaticResource Brush.SurfaceAlt}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180">
                                            <ItemsControl ItemsSource="{Binding DetailPanel.CurrentTask.Notes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:TaskNote}">
                                                        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                                            <DockPanel>
                                                                <Button Content="Sil"
                                                                        Command="{Binding DataContext.DetailPanel.RemoveNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        DockPanel.Dock="Right"
                                                                        Style="{StaticResource GhostButton}"/>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                                               FontSize="11"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Kaydet" Command="{Binding SaveActiveTabCommand}" Margin="4,0,4,0" Style="{StaticResource GhostButton}" ToolTip="Değişiklikleri Kaydet (Ctrl+S)"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedMainTab}" Value="{x:Static models:MainNavigationTab.Aksiyon}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <controls:DeferredContentControl IsActive="{Binding IsActionViewActivated}"
                                                 UnloadWhenInactive="True">
                    <controls:DeferredContentControl.DeferredTemplate>
                        <DataTemplate>
                            <sections:ActionSectionView/>
                        </DataTemplate>
                    </controls:DeferredContentControl.DeferredTemplate>
                </controls:DeferredContentControl>
            </Grid>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedMainTab}" Value="{x:Static models:MainNavigationTab.EksikProje}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="EKSİK PROJE"
                                               FontFamily="{StaticResource Font.Primary}"

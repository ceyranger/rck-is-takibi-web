<Window x:Class="RizaCanKilicIsTakibi.Views.ProjectCatalogEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RizaCanKilicIsTakibi.Views.Controls"
        Title="{Binding WindowTitle}"
        Width="620"
        Height="660"
        MinWidth="560"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Brush.AppBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding WindowTitle}"
                   FontFamily="{StaticResource Font.Primary}"
                   FontWeight="SemiBold"
                   FontSize="22"
                   Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Görünen Ad" FontWeight="SemiBold"/>
                <TextBox Margin="0,4,0,8" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Ada Parsel" FontWeight="SemiBold"/>
                <TextBox Margin="0,4,0,8" Text="{Binding AdaParsel, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Yapı Sahibi" FontWeight="SemiBold"/>
                <TextBox Margin="0,4,0,8" Text="{Binding YapiSahibi, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="YİBF No" FontWeight="SemiBold"/>
                <TextBox Margin="0,4,0,8" Text="{Binding YibfNo, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Belediye" FontWeight="SemiBold"/>
                <TextBox Margin="0,4,0,8" Text="{Binding Belediye, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Müteahhit" FontWeight="SemiBold"/>
                <TextBox Margin="0,4,0,8" Text="{Binding Muteahhit, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Tür" FontWeight="SemiBold"/>
                <ComboBox Margin="0,4,0,8"
                          ItemsSource="{Binding AvailableKinds}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedKindChoice, Mode=TwoWay}"/>

                <StackPanel Margin="0,0,0,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RequiresParent}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Üst Proje (zorunlu)" FontWeight="SemiBold"/>
                    <TextBlock Text="İstinat kaydı bir Normal üst projeye bağlanır. Ada/parsel veya isim yazarak seçin."
                               Margin="0,2,0,6"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               TextWrapping="Wrap"/>
                    <controls:ProjectPickerControl Margin="0,0,0,4"
                                                   AllowClear="False"
                                                   SelectedProjectId="{Binding ParentProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Catalog="{Binding ParentProjects}"/>
                    <TextBlock Text="{Binding ParentSelectionHint}"
                               Foreground="{StaticResource Brush.Danger}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <CheckBox Content="Aktif"
                          Margin="0,4,0,8"
                          IsChecked="{Binding IsActive, Mode=TwoWay}"/>

                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="{StaticResource Brush.Danger}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="İptal"
                    Style="{StaticResource GhostButton}"
                    Width="96"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Kaydet"
                    Width="120"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>

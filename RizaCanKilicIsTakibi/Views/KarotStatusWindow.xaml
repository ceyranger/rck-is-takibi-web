<Window x:Class="RizaCanKilicIsTakibi.Views.KarotStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kayıt Durumu"
        Width="420"
        Height="240"
        MinWidth="380"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Brush.AppBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Karot Kayıt Durumu"
                   FontFamily="{StaticResource Font.Primary}"
                   FontWeight="SemiBold"
                   FontSize="22"
                   Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Kayıt Durumu" FontWeight="SemiBold"/>
            <ComboBox Margin="0,6,0,0"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedValue="{Binding SelectedStatus, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="İptal"
                    Width="96"
                    Margin="0,0,8,0"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Kaydet"
                    Width="120"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>

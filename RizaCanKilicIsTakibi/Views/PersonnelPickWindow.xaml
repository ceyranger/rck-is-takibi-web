<Window x:Class="RizaCanKilicIsTakibi.Views.PersonnelPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personel Seç"
        Width="360"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.AppBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Personel seçin"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Personnel}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 DisplayMemberPath="Name"
                 Margin="0,0,0,12" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="İptal" Command="{Binding CancelCommand}" Width="90" Height="32" Margin="0,0,8,0" />
            <Button Content="Tamam" Command="{Binding OkCommand}" Width="90" Height="32" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>

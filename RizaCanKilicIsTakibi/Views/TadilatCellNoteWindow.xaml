<Window x:Class="RizaCanKilicIsTakibi.Views.TadilatCellNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:RizaCanKilicIsTakibi.Behaviors"
        Title="Hücre Notu"
        Width="500"
        Height="340"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Brush.AppBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Hücre Notu"
                   FontFamily="{StaticResource Font.Primary}"
                   FontWeight="SemiBold"
                   FontSize="22"
                   Margin="0,0,0,12"/>

        <TextBox Grid.Row="1"
                 Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 behaviors:TextBoxMouseWheelBehavior.IsEnabled="True"
                 Padding="10"
                 MinHeight="180"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Sil"
                    Width="96"
                    Margin="0,0,8,0"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding DeleteCommand}"/>
            <Button Content="İptal"
                    Width="96"
                    Margin="0,0,8,0"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Kaydet"
                    Width="120"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="RizaCanKilicIsTakibi.Views.PersonnelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personel Ayarları"
        Width="480"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Brush.AppBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Personel Ayarları"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Personnel}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 DisplayMemberPath="Name"
                 Margin="0,0,0,12" />

        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <Button Content="Ekle"
                    Command="{Binding AddCommand}"
                    Width="80"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0" />
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,0,0,12">
            <Button Content="Yeniden adlandır"
                    Command="{Binding RenameCommand}"
                    Width="120"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0" />
            <Button Content="Sil"
                    Command="{Binding DeleteCommand}"
                    Width="80"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0" />
            <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
        </DockPanel>

        <Button Grid.Row="4"
                Content="Kapat"
                Command="{Binding CloseCommand}"
                HorizontalAlignment="Right"
                Width="100"
                Height="32" />
    </Grid>
</Window>

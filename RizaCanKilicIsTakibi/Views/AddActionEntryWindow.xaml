<Window x:Class="RizaCanKilicIsTakibi.Views.AddActionEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:RizaCanKilicIsTakibi.Behaviors"
        xmlns:controls="clr-namespace:RizaCanKilicIsTakibi.Views.Controls"
        Title="Görev Ekle"
        Width="620"
        Height="460"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Brush.AppBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Yeni Aksiyon Kaydı"
                   FontFamily="{StaticResource Font.Primary}"
                   FontWeight="SemiBold"
                   FontSize="22"
                   Margin="0,0,0,10" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="White"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="İlçe" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding District}" Foreground="{StaticResource Brush.TextSecondary}" />
                        <TextBlock Text="Kategori" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource Brush.TextSecondary}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Proje (isteğe bağlı)" FontWeight="SemiBold" />
                <controls:ProjectPickerControl Margin="0,4,0,8"
                                               SelectedProjectId="{Binding SelectedProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               Catalog="{Binding CatalogEntries}" />

                <TextBlock Text="Ada Parsel Yapı Sahibi" FontWeight="SemiBold" />
                <TextBox Margin="0,4,0,8"
                         Text="{Binding OwnerParcelText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Yapılacak İş" FontWeight="SemiBold" />
                <TextBox Margin="0,4,0,8"
                         MinHeight="120"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         behaviors:TextBoxMouseWheelBehavior.IsEnabled="True"
                         Text="{Binding WorkText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="{StaticResource Brush.Danger}"
                           Margin="0,2,0,4"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="İptal"
                    Style="{StaticResource GhostButton}"
                    Width="96"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}" />
            <Button Content="Kaydet"
                    Width="120"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="RizaCanKilicIsTakibi.Views.YibfAnaBilgiEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="620"
        Height="520"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Brush.AppBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding WindowTitle}"
                   FontFamily="{StaticResource Font.Primary}"
                   FontWeight="SemiBold"
                   FontSize="22"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Ada Parsel" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding AdaParsel, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Text="YİBF No" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,12,0,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="8,12,0,0" Text="{Binding YibfNo, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Text="İdare" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,12,0,0"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="8,12,0,0" Text="{Binding Idare, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3" Text="Yapı Sahibi" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,12,0,0"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="8,12,0,0" Text="{Binding YapiSahibi, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="4" Text="Müteahhit" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,12,0,0"/>
            <TextBox Grid.Row="4" Grid.Column="1" Margin="8,12,0,0" Text="{Binding Muteahhit, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="5"
                       Grid.ColumnSpan="2"
                       Text="{Binding ValidationMessage}"
                       Foreground="{StaticResource Brush.Danger}"
                       Margin="0,16,0,0"
                       TextWrapping="Wrap"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="İptal"
                    Width="96"
                    Margin="0,0,8,0"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding CancelCommand}"/>
            <Button Content="{Binding PrimaryActionText}"
                    Width="120"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>

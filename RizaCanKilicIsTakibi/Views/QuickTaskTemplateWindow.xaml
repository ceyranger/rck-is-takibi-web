<Window x:Class="RizaCanKilicIsTakibi.Views.QuickTaskTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:RizaCanKilicIsTakibi.ViewModels"
        Title="Hızlı İş Ekle"
        Width="760"
        Height="600"
        MinWidth="700"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Brush.AppBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Hızlı İş Ekle"
                       FontFamily="{StaticResource Font.Primary}"
                       FontWeight="SemiBold"
                       FontSize="22"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding SelectedGroup.Name, StringFormat=Grup: {0}}"
                       DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextSecondary}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Gruplar"
                               FontWeight="SemiBold"
                               Margin="4,0,0,8" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Groups}"
                             SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:QuickTaskTemplateGroupViewModel}">
                                <DockPanel Margin="2,4">
                                    <TextBlock Text="{Binding TemplateCount}"
                                               DockPanel.Dock="Right"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextSecondary}" />
                                    <TextBlock Text="{Binding Name}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,8,0" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBox Margin="0,4,0,4"
                                 MinHeight="38"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" />
                        <UniformGrid Columns="2">
                            <Button Content="Grup Ekle"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding AddGroupCommand}" />
                            <Button Content="Grup Sil"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding DeleteSelectedGroupCommand}" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Grup İşleri"
                               FontWeight="SemiBold"
                               Margin="4,0,0,8" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:QuickTaskTemplateSelectionViewModel}">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Content="{Binding Title}"
                                          Padding="8,6"
                                          VerticalContentAlignment="Center" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Margin="0,4,8,4"
                                 MinHeight="40"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding NewTemplateTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Content="İş Ekle"
                                Width="110"
                                Command="{Binding AddTemplateCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding ValidationMessage}"
                   Foreground="{StaticResource Brush.Danger}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,4" />

        <DockPanel Grid.Row="3" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Hepsini Seç"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding SelectAllCommand}" />
                <Button Content="Seçimi Temizle"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding ClearSelectionCommand}" />
                <Button Content="İş Sil"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding DeleteSelectedTemplateCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="İptal"
                        Style="{StaticResource GhostButton}"
                        Width="96"
                        Command="{Binding CancelCommand}" />
                <Button Content="Seçilenleri Ekle"
                        Width="150"
                        Command="{Binding AddSelectedTasksCommand}" />
                <Button Content="Grubu Ekle"
                        Width="130"
                        Command="{Binding AddSelectedGroupTasksCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

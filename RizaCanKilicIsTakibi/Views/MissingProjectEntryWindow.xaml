<Window x:Class="RizaCanKilicIsTakibi.Views.MissingProjectEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:RizaCanKilicIsTakibi.Behaviors"
        xmlns:controls="clr-namespace:RizaCanKilicIsTakibi.Views.Controls"
        Title="Eksik Proje Kaydı Ekle"
        Width="640"
        Height="680"
        MinWidth="580"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FFEEF3F9">
    <Grid Background="{StaticResource Brush.EntryDialogBackground}">
        <Border Style="{StaticResource EntryDialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource EntryDialogHeaderStyle}">
                    <StackPanel>
                        <TextBlock Text="EKSİK PROJE" Style="{StaticResource EntryDialogEyebrowStyle}"/>
                        <TextBlock Text="Yeni kayıt" Style="{StaticResource EntryDialogTitleStyle}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="20,14,20,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="PROJE (İSTEĞE BAĞLI)" Style="{StaticResource EntryFieldLabelStyle}"/>
                        <Border Style="{StaticResource EntryFieldBoxStyle}" Padding="6">
                            <controls:ProjectPickerControl
                                SelectedProjectId="{Binding SelectedProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Catalog="{Binding CatalogEntries}"/>
                        </Border>

                        <Border Style="{StaticResource EntryProjectSummaryStyle}"
                                Visibility="{Binding HasSelectedProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ProjectSummaryText}" TextWrapping="Wrap"/>
                                <TextBlock Text="Projede Ada/Parsel veya Yapı Sahibi eksik; elle doldurun."
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.Warning}"
                                           Visibility="{Binding IsProjectIdentityIncomplete, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Button Content="{Binding IdentityEditToggleText}"
                                        Margin="0,8,0,0"
                                        Style="{StaticResource EntryLinkButtonStyle}"
                                        Command="{Binding ToggleIdentityManualEditCommand}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding ShowIdentityFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="ADA PARSEL" Style="{StaticResource EntryFieldLabelStyle}"/>
                            <Border Style="{StaticResource EntryFieldBoxStyle}">
                                <TextBox Style="{StaticResource EntryFieldTextBoxStyle}" Text="{Binding AdaParsel, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>
                            <TextBlock Text="YAPI SAHİBİ" Style="{StaticResource EntryFieldLabelStyle}"/>
                            <Border Style="{StaticResource EntryFieldBoxStyle}">
                                <TextBox Style="{StaticResource EntryFieldTextBoxStyle}" Text="{Binding YapiSahibi, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="EKSİK PROJE" Style="{StaticResource EntryFieldLabelStyle}"/>
                        <Border Style="{StaticResource EntryFieldBoxStyle}">
                            <TextBox Style="{StaticResource EntryFieldTextBoxStyle}" Text="{Binding MissingProjectText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>

                        <TextBlock Text="KAYIT ORTAMI" Style="{StaticResource EntryFieldLabelStyle}"/>
                        <Border Style="{StaticResource EntryFieldBoxStyle}">
                            <ComboBox BorderThickness="0" Background="Transparent" Padding="8,6"
                                      ItemsSource="{Binding MediumOptionItems}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding RecordMedium, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>

                        <TextBlock Text="KAYIT ORTAMI METNİ" Style="{StaticResource EntryFieldLabelStyle}"/>
                        <Border Style="{StaticResource EntryFieldBoxStyle}">
                            <TextBox Style="{StaticResource EntryFieldTextBoxStyle}" Text="{Binding RecordMediumText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>

                        <TextBlock Text="AÇIKLAMA" Style="{StaticResource EntryFieldLabelStyle}"/>
                        <Border Style="{StaticResource EntryFieldBoxStyle}">
                            <TextBox Style="{StaticResource EntryFieldMultilineTextBoxStyle}"
                                     behaviors:TextBoxMouseWheelBehavior.IsEnabled="True"
                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>

                        <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Style="{StaticResource EntryDialogFooterStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="İptal" Width="100" Margin="0,0,8,0" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}"/>
                        <Button Content="Kaydet" Width="120" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="RizaCanKilicIsTakibi.Views.MissingProjectEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:RizaCanKilicIsTakibi.Behaviors"
        xmlns:controls="clr-namespace:RizaCanKilicIsTakibi.Views.Controls"
        Title="Eksik Proje Kaydı Ekle"
        Width="620"
        Height="560"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Brush.AppBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Yeni Eksik Proje Kaydı"
                   FontFamily="{StaticResource Font.Primary}"
                   FontWeight="SemiBold"
                   FontSize="22"
                   Margin="0,0,0,10" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Proje (isteğe bağlı)" FontWeight="SemiBold" />
                <controls:ProjectPickerControl Margin="0,4,0,8"
                                               SelectedProjectId="{Binding SelectedProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               Catalog="{Binding CatalogEntries}" />

                <TextBlock Text="Ada Parsel" FontWeight="SemiBold" />
                <TextBox Margin="0,4,0,8" Text="{Binding AdaParsel, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Yapı Sahibi" FontWeight="SemiBold" />
                <TextBox Margin="0,4,0,8" Text="{Binding YapiSahibi, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Eksik Proje" FontWeight="SemiBold" />
                <TextBox Margin="0,4,0,8" Text="{Binding MissingProjectText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Kayıt Ortamı" FontWeight="SemiBold" />
                <ComboBox Margin="0,4,0,8"
                          ItemsSource="{Binding MediumOptionItems}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding RecordMedium, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Kayıt Ortamı Metni" FontWeight="SemiBold" />
                <TextBox Margin="0,4,0,8" Text="{Binding RecordMediumText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Açıklama" FontWeight="SemiBold" />
                <TextBox Margin="0,4,0,8"
                         MinHeight="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         behaviors:TextBoxMouseWheelBehavior.IsEnabled="True"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="{StaticResource Brush.Danger}"
                           Margin="0,2,0,4"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="İptal"
                    Style="{StaticResource GhostButton}"
                    Width="96"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}" />
            <Button Content="Kaydet"
                    Width="120"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>

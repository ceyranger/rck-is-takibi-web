<Window x:Class="RizaCanKilicIsTakibi.Views.PersonnelCellScopeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atama Kapsamı"
        Width="420"
        Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.AppBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   FontSize="15"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Row="1" Orientation="Vertical">
            <Button Content="Bu hücre"
                    Command="{Binding ThisCellCommand}"
                    Height="32"
                    Margin="0,0,0,8" />
            <Button Content="Satırdaki tüm kırmızı-sarı hücreler"
                    Command="{Binding AllRedYellowCommand}"
                    Height="32"
                    Margin="0,0,0,8" />
            <Button Content="İptal"
                    Command="{Binding CancelCommand}"
                    Height="32" />
        </StackPanel>
    </Grid>
</Window>
